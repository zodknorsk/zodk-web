logo-files/zodk-estrellas.png

# aeronaves en boceto (aún no aprobadas, generar-aeronaves.py las re-crea).
# Se quitan de aquí y se commitean cuando el usuario dé el visto bueno.
public/zodk-tb3.svg
public/zodk-tb3-noche.svg

# Proyecto Luna: fuentes de la NASA (~70 MB, se re-descargan con los curl de
# logo-files/generar-luna.py) y la caché de su pasada lenta.
logo-files/luna-fuentes/

# Caché de Python al importar los módulos de logo-files/ (png8, etc.)
__pycache__/

# Proyecto Marte: fuentes de la NASA/USGS (~800 MB, se re-descargan con los
# curl de logo-files/generar-marte.py) y la caché de su pasada lenta.
logo-files/marte-fuentes/

# Proyecto Marte: teselas del zoom (13 MB por versión). No se commitean hasta
# que el pixel art de Marte sea el definitivo, para no sumar 13 MB al
# historial cada vez que se regeneran (decisión del usuario, 21-sep-2026).
# Se sacan con: cd logo-files && python3 generar-marte.py --canvas ../public/marte/
public/marte/n*/
