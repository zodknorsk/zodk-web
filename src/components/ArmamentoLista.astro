---
// El índice del armamento (/uas/armamento): una fila por munición, con una
// miniatura de su primera foto, su nombre, su tipo y su país, en los grupos
// del índice de la nota (Misiles, Bombas guiadas). El usuario la eligió el
// 1-oct-2026 entre tarjetas como las de /uas, una tabla de datos sin fotos y
// filas con foto grande y la primera frase de la nota.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { banderaPorEmoji, svgBandera } from "../data/banderas";
import { slugMunicion, type GrupoMuniciones } from "@lib/armamento";

type Props = { grupos: GrupoMuniciones[] };
const { grupos } = Astro.props;

// La primera foto de cada munición (la de su nota, ya copiada por el importador).
const fotos = import.meta.glob<ImageMetadata>("/src/content/uas/armamento/*/*.{jpg,jpeg,png,webp}", { eager: true, import: "default" });
const fotoDe = (f: GrupoMuniciones["municiones"][number]) => {
  const nombre = (f.body ?? "").match(/!\[[^\]]*\]\(\.\/([^)\s]+)\)/)?.[1];
  return nombre ? fotos[`/src/content/uas/armamento/${slugMunicion(f)}/${nombre}`] : undefined;
};
const chapa = (emoji?: string) => {
  const p = emoji ? banderaPorEmoji(emoji) : undefined;
  return p ? svgBandera(p) : null;
};
---

<div class="animate arm-indice not-prose">
  {grupos.map((g) => (
    <section>
      <h2 class="arm-grupo">{g.titulo} <span>{g.municiones.length}</span></h2>
      <ul class="arm-lista">
        {g.municiones.map((f) => {
          const foto = fotoDe(f);
          const svg = chapa(f.data.bandera);
          return (
            <li>
              <a href={`/uas/${f.id}`}>
                <span class="arm-foto">{foto && <Image src={foto} alt="" width={160} />}</span>
                <span class="arm-nombre">{f.data.title}</span>
                <span class="arm-tipo">{f.data.categoria}</span>
                <span class="arm-pais">{svg ? <span class="bandera-uas" set:html={svg} /> : f.data.bandera} {f.data.pais}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>

<style>
  .arm-indice { display: flex; flex-direction: column; gap: 1.75rem; margin: 2rem 0 2.5rem; }
  .arm-grupo, .arm-tipo, .arm-pais {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .arm-grupo { margin: 0 0 0.75rem; font-size: 0.75rem; font-weight: 600; color: #18181b; }
  .arm-grupo span { opacity: 0.55; font-weight: 400; }
  :global(html.dark) .arm-grupo { color: #f4f4f5; }
  .arm-lista { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(0, 0, 0, 0.12); }
  :global(html.dark) .arm-lista { border-color: rgba(255, 255, 255, 0.12); }
  .arm-lista a {
    display: grid; grid-template-columns: 4.5rem 1fr auto; grid-template-rows: auto auto; column-gap: 0.9rem; align-items: center;
    padding: 0.55rem 0.25rem; border-bottom: 1px solid rgba(0, 0, 0, 0.12); text-decoration: none; transition: background 0.15s;
  }
  :global(html.dark) .arm-lista a { border-color: rgba(255, 255, 255, 0.12); }
  .arm-lista a:hover { background: rgba(0, 0, 0, 0.04); }
  :global(html.dark) .arm-lista a:hover { background: rgba(255, 255, 255, 0.05); }
  .arm-foto { grid-row: 1 / 3; aspect-ratio: 3 / 2; overflow: hidden; border-radius: 2px; background: #d4d4d8; }
  :global(html.dark) .arm-foto { background: #27272a; }
  .arm-foto :global(img) { display: block; width: 100%; height: 100%; margin: 0; object-fit: cover; }
  .arm-nombre { font-weight: 600; color: #18181b; }
  :global(html.dark) .arm-nombre { color: #f4f4f5; }
  .arm-tipo { grid-column: 2; font-size: 0.62rem; opacity: 0.7; }
  .arm-pais { grid-column: 3; grid-row: 1 / 3; font-size: 0.62rem; opacity: 0.7; white-space: nowrap; }
  .arm-lista a:hover .arm-pais { opacity: 1; }
  @media (max-width: 520px) {
    .arm-lista a { grid-template-columns: 4.5rem 1fr; }
    .arm-pais { display: none; }
  }
</style>
