---
import "../styles/global.css";
// Familia IBM Plex: Sans para interfaz y titulares, Serif para el texto de
// lectura, Mono para datos (handles, fechas, tiempo de lectura).
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-serif/latin-400.css";
import "@fontsource/ibm-plex-serif/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import plexSans400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2";
import plexSans600 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2";
import plexSerif400 from "@fontsource/ibm-plex-serif/files/ibm-plex-serif-latin-400-normal.woff2";
import plexSerif600 from "@fontsource/ibm-plex-serif/files/ibm-plex-serif-latin-600-normal.woff2";

import { ClientRouter } from "astro:transitions";
import { SITE } from "@consts";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// "image" es la imagen para redes (Open Graph / Twitter Card). Si una página no
// pasa la suya, se usa /og-image.png (el globo de la marca, 1200×630). La URL
// debe ser absoluta para que la lean los crawlers, de ahí el new URL(..., Astro.site).
const { title, description, image = "/og-image.png" } = Astro.props;
const socialImageURL = new URL(image, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- El sufijo -v2 fuerza a los navegadores (sobre todo Safari en iOS, que
     cachea el favicon por URL de forma muy agresiva y no lo suelta ni
     borrando datos) a descargar el icono nuevo en vez del de fábrica. Si se
     vuelve a cambiar el icono, subir el número. -->
<link rel="icon" href="/favicon-v2.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-v2.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16-v2.png">
<link rel="icon" type="image/svg+xml" href="/zodk-favicon-v2.svg">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v2.png">
<meta name="generator" content={Astro.generator} />

<!-- Sin JS, .animate nunca recibe la clase .show (la pone init() en el script
     de abajo): mostrar el contenido igualmente para que no quede invisible. -->
<noscript>
  <style>
    .animate { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

<!-- Font preloads -->
<link rel="preload" href={plexSans400} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={plexSans600} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={plexSerif400} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={plexSerif600} as="font" type="font/woff2" crossorigin/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />

<ClientRouter  />

<!-- RSS Link -->
<link rel="alternate" type="application/rss+xml" title={SITE.NAME} href={new URL("rss.xml", Astro.site)} />

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
  document.addEventListener("astro:before-swap", (e) =>
    [
      ...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll(
        "link[as=\"font\"]"
      ),
    ].forEach((link) => link.remove())
  );
</script>

<script is:inline>
  function init() {
    preloadTheme();
    initHeader();
    initCraft();
    initObjeto();
    initHelice();
    animate();

    const backToTop = document.getElementById("back-to-top");
    backToTop?.addEventListener("click", (event) => scrollToTop(event));

    const themeButton = document.getElementById("theme-button");
    themeButton?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "light" : "dark");
      toggleTheme(!isDark);
    });

    // Si el usuario no ha elegido tema a mano, seguir el del sistema en vivo.
    window.matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", event => {
        if (!localStorage.theme) {
          toggleTheme(event.matches);
        }
      }
    );

  }

  // La cabecera "sólida" (con logo) se activa con la clase "scrolled".
  // En la portada no salta al primer pixel: espera a que el contenido del blog
  // llegue arriba, usando un centinela invisible en el limite hero/contenido.
  // En el resto de paginas (sin centinela) se activa al primer scroll.
  function initHeader() {
    const sentinel = document.getElementById("hero-sentinel");
    if (sentinel && "IntersectionObserver" in window) {
      // "scrolled" = cabecera solida con logo. Se activa al bajar cuando el
      // limite hero/contenido cruza el 48% del viewport, y se retira al subir en
      // ese mismo punto (simetrico). El rootMargin define esa linea: mas
      // negativo -> linea mas arriba -> la cabecera aparece mas tarde.
      new IntersectionObserver(
        (entries) => {
          const e = entries[0];
          document.documentElement.classList.toggle(
            "scrolled",
            e.isIntersecting || e.boundingClientRect.top < 1
          );
        },
        { rootMargin: "0px 0px -52% 0px", threshold: 0 }
      ).observe(sentinel);
      // "at-top" = pegado arriba del todo (para la nav minima). Y ademas, a
      // medida que se baja, se tacha el titulo: --redact 0..1 segun el scroll
      // (el CSS reparte ese 0..1 por lineas). Se recalcula en un rAF.
      const titulo = document.querySelector(".hero-titulo");
      let raf = 0;
      const updateHero = () => {
        raf = 0;
        document.documentElement.classList.toggle("at-top", window.scrollY < 24);
        if (titulo) {
          const p = Math.min(1, window.scrollY / (window.innerHeight * 0.42));
          titulo.style.setProperty("--redact", p.toFixed(3));
        }
      };
      updateHero();
      document.addEventListener(
        "scroll",
        () => { if (!raf) raf = requestAnimationFrame(updateHero); },
        { passive: true }
      );
    } else {
      onScroll();
      document.addEventListener("scroll", onScroll);
    }
  }

  // Fichas de las naves: al pasar el raton, la nave se para (CSS :hover) y sale
  // la ficha. Aqui solo se decide, una vez al entrar, donde cae el recuadro para
  // que no se salga de pantalla; no hay bucle ni seguimiento.
  function initCraft() {
    if (!window.matchMedia("(hover: hover)").matches) return;
    document.querySelectorAll(".hero-craft").forEach((el) => {
      el.addEventListener("mouseenter", () => {
        const r = el.getBoundingClientRect();
        if (el.classList.contains("hero-craft--sweep")) {
          el.classList.toggle("flip-x", r.right + 360 > window.innerWidth);
        } else {
          const cx = r.left + r.width / 2;
          el.classList.toggle("edge-l", cx < 160);
          el.classList.toggle("edge-r", cx > window.innerWidth - 160);
        }
      });
    });
  }

  // Hero: UN objeto de AERONAVES a la vez, con su trayectoria. initObjeto()
  // elige el primero con "bolsa barajada" (se recorren todos antes de repetir;
  // localStorage recuerda el ultimo para no repetir al recargar) y engancha el
  // boton .hero-cambio: al pulsarlo, el objeto se desvanece, se le cambia
  // sprite + trayectoria + ficha por el siguiente de la bolsa y vuelve a
  // aparecer. Con reduced-motion el cambio es instantaneo pero el boton sigue.
  function initObjeto() {
    const data = document.getElementById("aeronaves-data");
    const el = document.querySelector(".hero-craft[data-slot]");
    const boton = document.querySelector(".hero-cambio");
    if (!data || !el) return;
    let pool;
    try { pool = JSON.parse(data.textContent); } catch (e) { return; }
    if (!Array.isArray(pool) || pool.length < 2) {
      if (boton) boton.hidden = true;
      return;
    }

    const sinMovimiento =
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Empieza la trayectoria ya avanzada, para que el objeto no aparezca
    // clavado en el extremo de su recorrido al cargar.
    const FASE0 = { sweep: 2, orbita: 6, fijo: 4, "fijo-izq": 4, "fijo-centro": 4 };

    function pinta(a) {
      el.classList.remove(
        "hero-craft--sweep", "hero-craft--orbita", "hero-craft--fijo",
        "hero-craft--fijo-izq", "hero-craft--fijo-centro", "flip-x", "edge-l", "edge-r"
      );
      el.classList.add("hero-craft--" + a.vuelo);
      el.dataset.craft = a.id;
      el.style.aspectRatio = a.ratio;
      el.style.setProperty("--sprite", "url(" + a.sprite + ")");
      el.style.setProperty("--sprite-noche", "url(" + a.spriteNoche + ")");
      el.style.setProperty("--escala", String(a.escala || 1));
      el.style.animation = "none";
      void el.offsetWidth; // reinicia la animacion de la trayectoria
      el.style.animation = "";
      el.style.animationDelay = "-" + (FASE0[a.vuelo] || 0) + "s";
      const specs = el.querySelector(".craft-specs");
      specs.querySelector(".craft-specs-titulo").textContent = a.nombre;
      specs.querySelector(".craft-clase").textContent = a.clase;
      specs.querySelector("dl").innerHTML = a.specs
        .map(([k, v]) => {
          const flag =
            k === "Origen" && a.bandera
              ? " <span class=\"craft-flag\">" + a.bandera + "</span>"
              : "";
          return "<dt>" + k + "</dt><dd>" + v + flag + "</dd>";
        })
        .join("");
    }

    // Bolsa barajada de indices: se saca de la bolsa hasta vaciarla y se vuelve
    // a barajar; nunca se repite el objeto actual de forma consecutiva.
    let bolsa = [];
    function rellenaBolsa() {
      bolsa = pool.map((_, i) => i);
      for (let i = bolsa.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const t = bolsa[i]; bolsa[i] = bolsa[j]; bolsa[j] = t;
      }
    }
    function sacaIndice(evita) {
      if (!bolsa.length) rellenaBolsa();
      if (bolsa.length === 1 && bolsa[0] === evita) rellenaBolsa();
      let k = bolsa.length - 1;
      while (k >= 0 && bolsa[k] === evita) k--;
      if (k < 0) k = bolsa.length - 1; // solo quedaba 'evita'
      return bolsa.splice(k, 1)[0];
    }

    let ultimo = -1;
    try { ultimo = Number(localStorage.getItem("hero-objeto")); } catch (e) {}
    if (!Number.isInteger(ultimo) || ultimo < 0 || ultimo >= pool.length) {
      ultimo = -1;
    }

    let actual = sacaIndice(ultimo);
    pinta(pool[actual]);
    try { localStorage.setItem("hero-objeto", String(actual)); } catch (e) {}
    // Revela el objeto: quita el ocultado de html.js y deja que el CSS lo funda
    // (instantaneo con reduced-motion).
    if (sinMovimiento) {
      el.dataset.listo = "";
    } else {
      requestAnimationFrame(() => { el.dataset.listo = ""; });
    }

    let cambiando = false;
    function cambia() {
      if (cambiando) return;
      cambiando = true;
      const siguiente = sacaIndice(actual);
      const aplica = () => {
        actual = siguiente;
        pinta(pool[actual]);
        try { localStorage.setItem("hero-objeto", String(actual)); } catch (e) {}
        el.classList.remove("rot-oculta");
        cambiando = false;
      };
      if (sinMovimiento) {
        aplica();
      } else {
        el.classList.add("rot-oculta");
        setTimeout(aplica, 750);
      }
    }

    if (boton) {
      boton.hidden = false;
      boton.addEventListener("click", cambia);
    }
  }

  // Helice del boton .hero-cambio: un bucle rAF lleva una velocidad angular que
  // tiende suavemente a "rapido" al pasar el raton / enfocar y a 0 al salir (se
  // para con inercia donde quede). El bucle solo corre mientras se mueve y se
  // apaga solo. Con reduced-motion no gira.
  function initHelice() {
    const boton = document.querySelector(".hero-cambio");
    const giro = boton && boton.querySelector(".btn-helice-giro");
    const disco = boton && boton.querySelector(".btn-helice-disco");
    if (!giro) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const MAX = 1300;   // grados/segundo a tope
    const EASE = 2.7;   // rapidez de aceleracion/frenada
    let ang = 0, vel = 0, target = 0, raf = 0, prev = 0;

    function tick(now) {
      if (!boton.isConnected) { raf = 0; return; }
      const dt = prev ? Math.min((now - prev) / 1000, 0.05) : 0;
      prev = now;
      vel += (target - vel) * Math.min(dt * EASE, 1);
      ang = (ang + vel * dt) % 360;
      giro.style.transform = "rotate(" + ang.toFixed(1) + "deg)";
      if (disco) {
        disco.style.opacity = (Math.min(1, Math.abs(vel) / MAX) * 0.4).toFixed(2);
      }
      if (target !== 0 || Math.abs(vel) > 1) {
        raf = requestAnimationFrame(tick);
      } else {
        vel = 0; raf = 0; prev = 0;
        if (disco) disco.style.opacity = "0";
      }
    }
    function mueve(t) {
      target = t;
      if (!raf) { prev = 0; raf = requestAnimationFrame(tick); }
    }
    boton.addEventListener("pointerenter", () => mueve(MAX));
    boton.addEventListener("pointerleave", () => mueve(0));
    boton.addEventListener("focus", () => mueve(MAX));
    boton.addEventListener("blur", () => mueve(0));
  }

  function animate() {
    const animateElements = document.querySelectorAll(".animate");

    animateElements.forEach((element, index) => {
      setTimeout(() => {
        element.classList.add("show");
      }, index * 150);
    });
  }

  function onScroll() {
    if (window.scrollY > 0) {
      document.documentElement.classList.add("scrolled");
    } else {
      document.documentElement.classList.remove("scrolled");
    }
  }

  function scrollToTop(event) {
    event.preventDefault();
    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  }

function toggleTheme(dark) {
    const css = document.createElement("style");

    css.appendChild(
      document.createTextNode(
        `* {
             -webkit-transition: none !important;
             -moz-transition: none !important;
             -o-transition: none !important;
             -ms-transition: none !important;
             transition: none !important;
          }
        `,
      )
    );

    document.head.appendChild(css);

    if (dark) {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }

  window.getComputedStyle(css).opacity;
    document.head.removeChild(css);
  }

  function preloadTheme() {
    const userTheme = localStorage.theme;

    if (userTheme === "light" || userTheme === "dark") {
      toggleTheme(userTheme === "dark");
    } else {
      toggleTheme(window.matchMedia("(prefers-color-scheme: dark)").matches);
    }
  }

  // Marca "hay JS" antes de pintar el body: el CSS usa html.js para que el
  // objeto del hero nazca oculto y lo funda initObjeto() al elegirlo al azar
  // (sin JS se ve el primero de la lista, sin fundido).
  document.documentElement.classList.add("js");

  document.addEventListener("DOMContentLoaded", () => init());
  document.addEventListener("astro:after-swap", () => init());
  preloadTheme();
</script>
