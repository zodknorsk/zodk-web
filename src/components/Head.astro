---
// Estilos, en este orden: los de toda la web, lo que comparten las tres
// portadas de astros y después cada una.
import "../styles/base.css";
import "../styles/astros.css";
import "../styles/portada.css";
import "../styles/luna.css";
import "../styles/marte.css";
// Familia IBM Plex: Sans para interfaz y titulares, Serif para el texto de
// lectura, Mono para datos (handles, fechas, tiempo de lectura).
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-serif/latin-400.css";
import "@fontsource/ibm-plex-serif/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css"; // rótulos de región de /marte
import "@fontsource/ibm-plex-mono/latin-600.css"; // lema del hero en negrita
import plexSans400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2";
import plexSans600 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2";
import plexSerif400 from "@fontsource/ibm-plex-serif/files/ibm-plex-serif-latin-400-normal.woff2";
import plexSerif600 from "@fontsource/ibm-plex-serif/files/ibm-plex-serif-latin-600-normal.woff2";

import { ClientRouter } from "astro:transitions";
import { SITE } from "@consts";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// "image" es la imagen para redes (Open Graph / Twitter Card). Si una página no
// pasa la suya, se usa /og-image.png (el globo de la marca, 1200×630). La URL
// debe ser absoluta para que la lean los crawlers, de ahí el new URL(..., Astro.site).
const { title, description, image = "/og-image.png" } = Astro.props;
const socialImageURL = new URL(image, Astro.site);
---

<!-- Básicos e iconos -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- El sufijo -v2 fuerza a los navegadores (sobre todo Safari en iOS, que
     cachea el favicon por URL de forma muy agresiva y no lo suelta ni
     borrando datos) a descargar el icono nuevo en vez del de fábrica. Si se
     vuelve a cambiar el icono, subir el número. -->
<link rel="icon" href="/favicon-v2.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-v2.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16-v2.png">
<link rel="icon" type="image/svg+xml" href="/zodk-favicon-v2.svg">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v2.png">
<meta name="generator" content={Astro.generator} />

<!-- Sin JS, .animate nunca recibe la clase .show (la pone init() en el script
     de abajo): mostrar el contenido igualmente para que no quede invisible. -->
<noscript>
  <style>
    .animate { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

<!-- Fuentes que se usan nada más cargar -->
<link rel="preload" href={plexSans400} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={plexSans600} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={plexSerif400} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={plexSerif600} as="font" type="font/woff2" crossorigin/>

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Vista previa al compartir (Open Graph y Twitter) -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />

<ClientRouter />

<link rel="alternate" type="application/rss+xml" title={SITE.NAME} href={new URL("rss.xml", Astro.site)} />

<script>
  // Al cambiar de página las fuentes ya están cargadas: no hace falta volver
  // a precargarlas.
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
  document.addEventListener("astro:before-swap", (e) => {
    const nueva = (e as TransitionBeforeSwapEvent).newDocument;
    nueva.head.querySelectorAll("link[as=font]").forEach((link) => link.remove());
  });
</script>

<script is:inline>
  function init() {
    preloadTheme();
    initHeader();
    initCraft();
    initObjeto();
    initHelice();
    animate();

    const themeButton = document.getElementById("theme-button");
    themeButton?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      try { sessionStorage.setItem("theme", isDark ? "light" : "dark"); } catch { /* sin sessionStorage: solo esta página */ }
      toggleTheme(!isDark);
      // El icono nuevo sale relleno y se vacía (.tema-pulsado en base.css).
      themeButton.classList.remove("tema-pulsado");
      void themeButton.offsetWidth;                // reinicia la animación
      themeButton.classList.add("tema-pulsado");
      clearTimeout(themeButton._tPulsado);
      themeButton._tPulsado = setTimeout(() => themeButton.classList.remove("tema-pulsado"), 900);
      marcaEstrellas(!isDark);
    });
  }

  // Al pasar a noche, las estrellas de más del hero (.hero-stars::after) se
  // encienden poco a poco en vez de salir de golpe: html.estrellas-entrando
  // mientras dura (astros.css). Solo al cambiar de tema, no al cargar.
  let tEstrellas = 0;
  function marcaEstrellas(aNoche) {
    const html = document.documentElement;
    html.classList.remove("estrellas-entrando");
    clearTimeout(tEstrellas);
    if (!aNoche) return;
    void html.offsetWidth;
    html.classList.add("estrellas-entrando");
    tEstrellas = setTimeout(() => html.classList.remove("estrellas-entrando"), 3200);
  }

  // La cabecera "sólida" (con logo) se activa con la clase "scrolled".
  // En la portada no salta al primer píxel: espera a que el contenido del blog
  // llegue arriba, con un centinela invisible en el límite entre el hero y el
  // contenido (#hero-sentinel). En el resto de páginas, al primer scroll.
  // El escuchador del scroll se pone una sola vez (la web cambia de página
  // sin recargar y init() se repite en cada cambio) y mira qué página hay.
  let observador = null;
  function initHeader() {
    observador?.disconnect();
    observador = null;
    const sentinel = document.getElementById("hero-sentinel");
    if (sentinel && "IntersectionObserver" in window) {
      // "scrolled" se pone cuando el límite hero/contenido cruza el 48 % de la
      // ventana, bajando o subiendo. Más negativo el margen -> más tarde.
      observador = new IntersectionObserver(
        ([e]) => {
          document.documentElement.classList.toggle("scrolled", e.isIntersecting || e.boundingClientRect.top < 1);
        },
        { rootMargin: "0px 0px -52% 0px", threshold: 0 },
      );
      observador.observe(sentinel);
    }
    alScroll();
  }
  // En la portada: "at-top" (pegado arriba del todo, la cabecera mínima) y la
  // censura del título según se baja (--redact de 0 a 1; el CSS la reparte
  // por líneas). En las demás páginas, "scrolled" desde el primer píxel.
  function alScroll() {
    const html = document.documentElement;
    if (document.getElementById("hero-sentinel")) {
      html.classList.toggle("at-top", window.scrollY < 24);
      const p = Math.min(1, window.scrollY / (window.innerHeight * 0.42));
      document.querySelector(".hero-titulo")?.style.setProperty("--redact", p.toFixed(3));
    } else {
      html.classList.toggle("scrolled", window.scrollY > 0);
    }
  }
  let rafScroll = 0;
  document.addEventListener("scroll", () => {
    if (!rafScroll) rafScroll = requestAnimationFrame(() => { rafScroll = 0; alScroll(); });
  }, { passive: true });

  // Fichas de las naves: al pasar el ratón, la nave se para (CSS :hover) y sale
  // la ficha. Aquí solo se decide, al entrar, a qué lado cae el recuadro para
  // que no se salga de la pantalla.
  function initCraft() {
    if (!window.matchMedia("(hover: hover)").matches) return;
    document.querySelectorAll(".hero-craft").forEach((el) => {
      el.addEventListener("mouseenter", () => {
        const r = el.getBoundingClientRect();
        el.classList.toggle("flip-x", r.right + 360 > window.innerWidth);
      });
    });
  }

  // Un objeto de AERONAVES (src/data/aeronaves.ts) a la vez en el hero, con
  // su trayectoria. Se eligen de una bolsa barajada (salen todos antes de
  // repetir; localStorage recuerda el último para no repetirlo al recargar).
  // El botón .hero-cambio lo desvanece, le pone dibujo, trayectoria y ficha
  // del siguiente y lo vuelve a mostrar. Con reduced-motion, sin fundido.
  function initObjeto() {
    const data = document.getElementById("aeronaves-data");
    const el = document.querySelector(".hero-craft[data-slot]");
    const boton = document.querySelector(".hero-cambio");
    if (!data || !el) return;
    let pool;
    try { pool = JSON.parse(data.textContent); } catch (e) { return; }
    if (!Array.isArray(pool) || pool.length < 2) {
      if (boton) boton.hidden = true;
      return;
    }

    const sinMovimiento =
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Empieza la trayectoria ya avanzada, para que el objeto no aparezca
    // clavado en el extremo de su recorrido al cargar.
    const FASE0 = {
      sweep: 2, orbita: 6, fijo: 4, "fijo-izq": 4, "fijo-centro": 4,
      "fijo-arriba": 4, "fijo-arriba-der": 4,
    };

    function pinta(a) {
      el.classList.remove(
        "hero-craft--sweep", "hero-craft--orbita", "hero-craft--fijo",
        "hero-craft--fijo-izq", "hero-craft--fijo-centro", "hero-craft--fijo-arriba",
        "hero-craft--fijo-arriba-der", "hero-craft--pixelado", "flip-x"
      );
      el.classList.add("hero-craft--" + a.vuelo);
      // Solo el pixel art (.svg) va sin suavizar; las fotos (.png) se ven
      // mejor, y sin parpadeo al moverse, con el suavizado del navegador.
      if (a.sprite.endsWith(".svg")) el.classList.add("hero-craft--pixelado");
      el.dataset.craft = a.id;
      el.style.aspectRatio = a.ratio;
      el.style.setProperty("--sprite", "url(" + a.sprite + ")");
      el.style.setProperty("--sprite-noche", "url(" + a.spriteNoche + ")");
      el.style.setProperty("--escala", String(a.escala || 1));
      for (const k of ["der", "izq"]) {   // luces de posición (de noche)
        const luz = el.querySelector(".craft-luz--" + k);
        const p = a.luces && a.luces[k];
        if (!luz) continue;
        luz.hidden = !p;
        if (p) { luz.style.left = p[0] + "%"; luz.style.top = p[1] + "%"; }
      }
      el.style.animation = "none";
      void el.offsetWidth; // reinicia la animación de la trayectoria
      el.style.animation = "";
      el.style.animationDelay = "-" + (FASE0[a.vuelo] || 0) + "s";
      const specs = el.querySelector(".craft-specs");
      specs.querySelector(".craft-specs-titulo").textContent = a.nombre;
      specs.querySelector(".craft-clase").textContent = a.clase;
      specs.querySelector("dl").innerHTML = a.specs
        .map(([k, v]) => {
          const flag =
            k === "Origen" && a.bandera
              ? " <span class=\"craft-flag\">" + a.bandera + "</span>"
              : "";
          return "<dt>" + k + "</dt><dd>" + v + flag + "</dd>";
        })
        .join("");
    }

    // Bolsa barajada de índices: se saca hasta vaciarla y se vuelve a barajar;
    // nunca sale dos veces seguidas el mismo.
    let bolsa = [];
    function rellenaBolsa() {
      bolsa = pool.map((_, i) => i);
      for (let i = bolsa.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const t = bolsa[i]; bolsa[i] = bolsa[j]; bolsa[j] = t;
      }
    }
    function sacaIndice(evita) {
      if (!bolsa.length) rellenaBolsa();
      if (bolsa.length === 1 && bolsa[0] === evita) rellenaBolsa();
      let k = bolsa.length - 1;
      while (k >= 0 && bolsa[k] === evita) k--;
      if (k < 0) k = bolsa.length - 1; // solo quedaba 'evita'
      return bolsa.splice(k, 1)[0];
    }

    let ultimo = -1;
    try { ultimo = Number(localStorage.getItem("hero-objeto")); } catch { /* localStorage no disponible */ }
    if (!Number.isInteger(ultimo) || ultimo < 0 || ultimo >= pool.length) {
      ultimo = -1;
    }

    let actual = sacaIndice(ultimo);
    pinta(pool[actual]);
    try { localStorage.setItem("hero-objeto", String(actual)); } catch { /* localStorage no disponible */ }
    // Lo muestra: quita el ocultado de html.js y el CSS lo funde (de golpe con
    // reduced-motion).
    if (sinMovimiento) {
      el.dataset.listo = "";
    } else {
      requestAnimationFrame(() => { el.dataset.listo = ""; });
    }

    let cambiando = false;
    function cambia() {
      if (cambiando) return;
      cambiando = true;
      const siguiente = sacaIndice(actual);
      const aplica = () => {
        actual = siguiente;
        pinta(pool[actual]);
        try { localStorage.setItem("hero-objeto", String(actual)); } catch { /* localStorage no disponible */ }
        el.classList.remove("rot-oculta");
        cambiando = false;
      };
      if (sinMovimiento) {
        aplica();
      } else {
        el.classList.add("rot-oculta");
        setTimeout(aplica, 750);
      }
    }

    if (boton) {
      boton.hidden = false;
      boton.addEventListener("click", cambia);
    }
  }

  // Hélice del botón .hero-cambio: acelera al pasar el ratón (o al enfocarlo)
  // y al salir frena con inercia hasta pararse donde quede. El bucle de rAF
  // solo corre mientras se mueve. Con reduced-motion no gira.
  function initHelice() {
    const boton = document.querySelector(".hero-cambio");
    const giro = boton && boton.querySelector(".btn-helice-giro");
    const disco = boton && boton.querySelector(".btn-helice-disco");
    if (!giro) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const MAX = 1300;   // grados/segundo a tope
    const EASE = 2.7;   // rapidez de aceleración y frenada
    let ang = 0, vel = 0, target = 0, raf = 0, prev = 0;

    function tick(now) {
      if (!boton.isConnected) { raf = 0; return; }
      const dt = prev ? Math.min((now - prev) / 1000, 0.05) : 0;
      prev = now;
      vel += (target - vel) * Math.min(dt * EASE, 1);
      ang = (ang + vel * dt) % 360;
      giro.style.transform = "rotate(" + ang.toFixed(1) + "deg)";
      if (disco) {
        disco.style.opacity = (Math.min(1, Math.abs(vel) / MAX) * 0.4).toFixed(2);
      }
      if (target !== 0 || Math.abs(vel) > 1) {
        raf = requestAnimationFrame(tick);
      } else {
        vel = 0; raf = 0; prev = 0;
        if (disco) disco.style.opacity = "0";
      }
    }
    function mueve(t) {
      target = t;
      if (!raf) { prev = 0; raf = requestAnimationFrame(tick); }
    }
    boton.addEventListener("pointerenter", () => mueve(MAX));
    boton.addEventListener("pointerleave", () => mueve(0));
    boton.addEventListener("focus", () => mueve(MAX));
    boton.addEventListener("blur", () => mueve(0));
  }

  function animate() {
    const animateElements = document.querySelectorAll(".animate");

    animateElements.forEach((element, index) => {
      setTimeout(() => {
        element.classList.add("show");
      }, index * 150);
    });
  }

  // Cambia de tema de golpe: sin transiciones mientras se pone o quita .dark.
  function toggleTheme(dark) {
    const css = document.createElement("style");
    css.textContent = "* { transition: none !important; }";
    document.head.appendChild(css);
    document.documentElement.classList.toggle("dark", dark);
    window.getComputedStyle(css).opacity;   // obliga a aplicar los estilos antes de quitarlo
    document.head.removeChild(css);
  }

  // Tema al cargar: de día, aunque el sistema esté en modo oscuro. La noche
  // que se elija con el botón (o la que pone el vuelo a la Luna) dura lo que
  // la visita: va en sessionStorage, así que aguanta al navegar y al recargar,
  // pero una visita nueva empieza de día. Lo que quede en localStorage de
  // cuando se guardaba ahí, se borra.
  function preloadTheme() {
    let userTheme = null;
    try {
      localStorage.removeItem("theme");
      userTheme = sessionStorage.getItem("theme");
    } catch { /* sin almacenamiento: de día */ }
    toggleTheme(userTheme === "dark");
  }

  // Marca "hay JS" antes de pintar el body: el CSS usa html.js para que el
  // objeto del hero nazca oculto y lo funda initObjeto() al elegirlo al azar
  // (sin JS se ve el primero de la lista, sin fundido).
  document.documentElement.classList.add("js");

  document.addEventListener("DOMContentLoaded", () => init());
  document.addEventListener("astro:after-swap", () => init());
  preloadTheme();
</script>
