---
interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString("es-ES", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC", // la fecha es solo "día" (sin hora): fijamos UTC para
      // que no dependa de la zona horaria de la máquina donde se compila
    })
  }
</time>
