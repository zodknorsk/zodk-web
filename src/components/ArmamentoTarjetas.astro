---
// El índice del armamento (/uas/armamento): una tarjeta por munición, con su
// primera foto, su país, su nombre y su tipo, en los grupos del índice de la
// nota (Misiles, Bombas guiadas). Mismo aire que las tarjetas de /uas.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { banderaPorEmoji, svgBandera } from "../data/banderas";
import { slugMunicion, type GrupoMuniciones } from "@lib/armamento";

type Props = { grupos: GrupoMuniciones[] };
const { grupos } = Astro.props;

// La primera foto de cada munición (la de su nota, ya copiada por el importador).
const fotos = import.meta.glob<ImageMetadata>("/src/content/uas/armamento/*/*.{jpg,jpeg,png,webp}", { eager: true, import: "default" });
const fotoDe = (f: GrupoMuniciones["municiones"][number]) => {
  const nombre = (f.body ?? "").match(/!\[[^\]]*\]\(\.\/([^)\s]+)\)/)?.[1];
  return nombre ? fotos[`/src/content/uas/armamento/${slugMunicion(f)}/${nombre}`] : undefined;
};
const chapa = (emoji?: string) => {
  const p = emoji ? banderaPorEmoji(emoji) : undefined;
  return p ? svgBandera(p) : null;
};
---

<div class="animate arm-indice not-prose">
  {grupos.map((g) => (
    <section>
      <h2 class="arm-grupo">{g.titulo} <span>{g.municiones.length}</span></h2>
      <ul class="arm-tarjetas">
        {g.municiones.map((f) => {
          const foto = fotoDe(f);
          const svg = chapa(f.data.bandera);
          return (
            <li>
              <a href={`/uas/${f.id}`} class="arm-tarjeta">
                <span class="arm-foto">
                  {foto && <Image src={foto} alt="" width={480} />}
                </span>
                <span class="arm-texto">
                  <span class="arm-pais">
                    {svg ? <span class="bandera-uas" set:html={svg} /> : f.data.bandera} {f.data.pais}
                  </span>
                  <span class="arm-nombre">{f.data.title}</span>
                  {f.data.categoria && <span class="arm-tipo">{f.data.categoria}</span>}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>

<style>
  .arm-indice { display: flex; flex-direction: column; gap: 1.75rem; margin: 2rem 0 2.5rem; }
  .arm-grupo, .arm-pais, .arm-tipo {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .arm-grupo { margin: 0 0 0.75rem; font-size: 0.75rem; font-weight: 600; color: #18181b; }
  .arm-grupo span { opacity: 0.55; font-weight: 400; }
  :global(html.dark) .arm-grupo { color: #f4f4f5; }
  .arm-tarjetas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  @media (max-width: 520px) { .arm-tarjetas { grid-template-columns: 1fr; } }
  .arm-tarjeta {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.13);
    border-radius: 4px;
    background: #ebebee;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  :global(html.dark) .arm-tarjeta { border-color: rgba(255, 255, 255, 0.13); background: #25252a; }
  .arm-tarjeta:hover { border-color: #27272a; box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.35); }
  :global(html.dark) .arm-tarjeta:hover { border-color: #e4e4e7; }
  .arm-foto { display: block; aspect-ratio: 3 / 2; overflow: hidden; background: #d4d4d8; }
  :global(html.dark) .arm-foto { background: #18181b; }
  .arm-foto :global(img) { display: block; width: 100%; height: 100%; margin: 0; object-fit: cover; }
  .arm-texto { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.75rem 0.9rem 0.9rem; }
  .arm-pais, .arm-tipo { font-size: 0.62rem; opacity: 0.7; }
  .arm-tarjeta:hover .arm-pais { opacity: 1; }
  .arm-nombre { font-size: 1.05rem; font-weight: 600; color: #18181b; }
  :global(html.dark) .arm-nombre { color: #f4f4f5; }
</style>
