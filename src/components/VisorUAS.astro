---
// Visor de la maqueta de un dron, con aspecto de tarjeta de identificación de
// aeronaves: maqueta 3D con partes marcadas por letras, tira de siluetas
// (planta, perfil, frente) que hacen de vistas, y un panel con dos pestañas:
// las partes y las fuentes en las que se basa la reconstrucción. El marco y los textos salen aquí, en
// el build; src/scripts/visor-uas.ts pone la maqueta y la interacción.
// La maqueta se elige por su nombre de archivo en src/data/uas/ (p. ej. "mich-2000").
import type { Maqueta } from "../data/uas/tipos";
import { svgBandera } from "../data/alunizajes";
import { STACK } from "@consts";

type Props = { modelo: string };
const { modelo } = Astro.props;

const todas = import.meta.glob<{ default: Maqueta }>(["../data/uas/*.ts", "!../data/uas/tipos.ts"], { eager: true });
const m = todas[`../data/uas/${modelo}.ts`]?.default;
if (!m) throw new Error(`VisorUAS: no hay maqueta "${modelo}" en src/data/uas/`);

// Iconos del crédito: Clawd, el mismo de la tira «Hecho con» de la portada, y
// el oficial de Three.js (simple-icons), en el color del texto.
const ICONO_CLAUDE = STACK.find((t) => t.NAME === "Claude")?.ICONO ?? "";
const ICONO_THREE = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.38 0a.268.268 0 0 0-.256.332l2.894 11.716a.268.268 0 0 0 .01.04l2.89 11.708a.268.268 0 0 0 .447.128L23.802 7.15a.268.268 0 0 0-.112-.45l-5.784-1.667a.268.268 0 0 0-.123-.035L6.38 1.715a.268.268 0 0 0-.144-.04L.456.01A.268.268 0 0 0 .38 0zm.374.654L5.71 2.08 1.99 5.664zM6.61 2.34l4.864 1.4-3.65 3.515zm-.522.12l1.217 4.926-4.877-1.4zm6.28 1.538l4.878 1.404-3.662 3.53zm-.52.13l1.208 4.9-4.853-1.392zm6.3 1.534l4.947 1.424-3.715 3.574zm-.524.12l1.215 4.926-4.876-1.398zm-15.432.696l4.964 1.424-3.726 3.586zM8.047 8.15l4.877 1.4-3.66 3.527zm-.518.137l1.236 5.017-4.963-1.432zm6.274 1.535l4.965 1.425-3.73 3.586zm-.52.127l1.235 5.012-4.958-1.43zm-9.63 2.438l4.873 1.406-3.656 3.523zm5.854 1.687l4.863 1.403-3.648 3.51zm-.54.04l1.214 4.927-4.875-1.4zm-3.896 4.02l5.037 1.442-3.782 3.638z"/></svg>`;

const letra = (i: number) => String.fromCharCode(65 + i);
const RESPALDO = { foto: "Se ve en las fotos", reconstruccion: "Reconstrucción", fabricante: "Dato del fabricante" };
// Qué partes (letras) respalda cada fuente.
const respalda = (id: string) => m.partes.flatMap((p, i) => (p.fuentes.includes(id) ? [letra(i)] : []));
const VISTAS = [
  { vista: "arriba", nombre: "Planta" },
  { vista: "lado", nombre: "Perfil" },
  { vista: "frente", nombre: "Frente" },
  { vista: "3d", nombre: "3D" },
];
---

<section class="visor" data-modelo={modelo} aria-label={`${m.nombre}: ficha y maqueta interactiva`}>
  <div class="visor-cab">
    <div>
      <p class="visor-expediente">
        <span class="visor-bandera" set:html={svgBandera(m.pais)} />
        <span>{m.pais.nombre}</span>
      </p>
      <h2 class="visor-titulo">{m.nombre}</h2>
      <p class="visor-subtitulo">{m.subtitulo}</p>
    </div>
    <p class="visor-credito">
      Maqueta creada a partir de fotos públicas. Hecho con<br />
      <a href="https://threejs.org" target="_blank" rel="noopener"><span class="visor-credito-icono" set:html={ICONO_THREE} />Three.js</a><br />
      <a href="https://claude.com/claude-code" target="_blank" rel="noopener"><span class="visor-credito-icono" set:html={ICONO_CLAUDE} />Claude Code</a>
    </p>
  </div>

  <div class="visor-cuerpo">
    <div class="visor-escena">
      <div class="visor-lienzo-caja">
        <canvas
          class="visor-lienzo"
          tabindex="0"
          role="img"
          aria-label={`Maqueta 3D del ${m.nombre}. Arrastra para girarla; las flechas también giran y + y − acercan.`}></canvas>
        <!-- Chinchetas con letra y el rótulo de la parte elegida, con su línea
             hasta la pieza. Las coloca el script. -->
        <svg class="visor-guia" aria-hidden="true"><line></line></svg>
        <div class="visor-pines">
          {m.partes.map((p, i) => (
            <button type="button" class="visor-pin" data-parte={i} aria-label={p.nombre} title={p.nombre}>{letra(i)}</button>
          ))}
          <p class="visor-rotulo" hidden></p>
        </div>
        <p class="visor-ayuda" aria-hidden="true">Arrastra para girar · rueda o pellizco para acercar</p>
        <p class="visor-sin-webgl-aviso">Este navegador no puede mostrar la maqueta 3D (sin WebGL).</p>
      </div>
      <div class="visor-barra">
        <div class="visor-siluetas" role="group" aria-label="Vistas">
          {VISTAS.map(({ vista, nombre }) => (
            <button type="button" data-vista={vista} aria-pressed={vista === "3d" ? "true" : "false"}>
              <span class="visor-silueta" aria-hidden="true"></span>
              <span class="visor-silueta-nombre">{nombre}</span>
            </button>
          ))}
        </div>
        <div class="visor-herramientas">
          <div class="visor-estilo" role="group" aria-label="Estilo">
            <button type="button" data-estilo="maqueta" aria-pressed="true">Maqueta</button>
            <button type="button" data-estilo="pixel" aria-pressed="false" title="Pixel art">Pixel</button>
          </div>
          <button type="button" data-accion="girar" aria-pressed="false" title="Girar solo">Girar</button>
          <button type="button" data-accion="alejar" aria-label="Alejar" title="Alejar">−</button>
          <button type="button" data-accion="acercar" aria-label="Acercar" title="Acercar">+</button>
        </div>
      </div>
    </div>

    <aside class="visor-panel">
      <div class="visor-pestanas" role="tablist" aria-label="Información de la maqueta">
        <button type="button" role="tab" data-pestana="partes" aria-selected="true">Partes</button>
        <button type="button" role="tab" data-pestana="fuentes" aria-selected="false">Fuentes <span>{m.fuentes.length}</span></button>
      </div>

      <div class="visor-hoja" data-hoja="partes" role="tabpanel">
        <ol class="visor-lista">
          {m.partes.map((p, i) => (
            <li>
              <button type="button" data-parte={i} aria-pressed="false">
                <span class="visor-letra">{letra(i)}</span>{p.nombre}
              </button>
            </li>
          ))}
        </ol>
        {m.partes.map((p, i) => (
          <div class="visor-ficha" data-ficha={i} hidden>
            <p class={`visor-respaldo visor-respaldo--${p.respaldo}`}>{RESPALDO[p.respaldo]}</p>
            <h3 class="visor-ficha-nombre"><span class="visor-letra">{letra(i)}</span>{p.nombre}</h3>
            <p class="visor-ficha-texto">{p.texto}</p>
            {p.nota && <p class="visor-ficha-nota">{p.nota}</p>}
            <button type="button" class="visor-ficha-fuentes" data-pestana="fuentes">
              Ver sus fuentes ({p.fuentes.length}) →
            </button>
          </div>
        ))}
      </div>

      <!-- Fuentes: las fotos y artículos en los que se basa la maqueta. Con una
           parte elegida, se apagan las que no la respaldan. -->
      <div class="visor-hoja" data-hoja="fuentes" role="tabpanel" hidden>
        <p class="visor-hoja-intro">En qué se basa la maqueta.</p>
        <ul class="visor-fuentes-lista">
          {m.fuentes.map((f) => (
            <li data-fuente={f.id} class={f.imagen ? "" : "visor-fuente--articulo"}>
              <a href={f.url} target="_blank" rel="noopener">
                {f.imagen
                  ? <img src={`/uas/${modelo}/fuentes/${f.imagen}`} alt={f.titulo} loading="lazy" width="560" height="373" />
                  : <span class="visor-fuente-icono" aria-hidden="true">¶</span>}
                <span class="visor-fuente-texto">
                  <span class="visor-fuente-medio">{f.medio}{!f.imagen && " · artículo"}</span>
                  <span class="visor-fuente-titulo">{f.titulo}</span>
                  <span class="visor-fuente-respalda">Respalda: {respalda(f.id).join(" · ")}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>

</section>

<script>
  // La web cambia de página sin recargar (ClientRouter): el visor se monta en
  // cada llegada y se desmonta al salir. Cada maqueta va en su propio trozo de
  // JavaScript y solo se baja la que se usa.
  import type { Maqueta } from "../data/uas/tipos";
  const maquetas = import.meta.glob<{ default: Maqueta }>(["../data/uas/*.ts", "!../data/uas/tipos.ts"]);
  let quitar: (() => void)[] = [];
  // Cada llegada a una página tiene su número: un montaje que termina de
  // cargar cuando ya se ha cambiado de página (atrás/adelante rápido) no se
  // hace.
  let visita = 0;
  const desmontar = () => {
    visita++;
    quitar.forEach((q) => q());
    quitar = [];
  };

  document.addEventListener("astro:page-load", async () => {
    desmontar();
    const esta = visita;
    // En las fichas de /uas, el visor se pinta tras el texto y va a su hueco
    // de la sección «Visor» antes de montarse.
    const hueco = document.querySelector("article .visor-hueco");
    const deLaFicha = document.getElementById("visor-nota");
    if (hueco && deLaFicha) hueco.replaceWith(deLaFicha);
    for (const caja of document.querySelectorAll<HTMLElement>(".visor")) {
      const cargar = maquetas[`../data/uas/${caja.dataset.modelo}.ts`];
      if (!cargar) continue;
      const [{ montarVisor }, { default: maqueta }] = await Promise.all([import("../scripts/visor-uas"), cargar()]);
      if (esta !== visita || !caja.isConnected) return;
      quitar.push(montarVisor(caja, maqueta));
    }
  });
  document.addEventListener("astro:before-swap", desmontar);
</script>

<style is:global>
  .visor {
    /* Tarjeta un poco más oscura que la página de día y un poco más clara de
       noche. Sin color de acento: lo elegido va en tinta, como en un manual
       de reconocimiento; el único color es la bandera. */
    --visor-tinta: #27272a;
    /* La maqueta, negro mate como los ejemplares de la fábrica; la parte
       elegida, en blanco papel. */
    --visor-relleno: #454950;
    --visor-arista: #a3a9b1;
    --visor-resalte: #f4f4f5;
    --visor-resalte-arista: #71717a;
    --visor-acento: #27272a;
    --visor-sobre-acento: #fafafa;
    --visor-borde: rgba(0, 0, 0, 0.13);
    --visor-fondo: #ebebee;
    --visor-texto: #18181b;
    --visor-suave: #71717a;
    border: 1px solid var(--visor-borde);
    border-radius: 4px;
    background: var(--visor-fondo);
    color: var(--visor-texto);
    overflow: hidden;
    container-type: inline-size;
  }
  html.dark .visor {
    --visor-tinta: #d4d4d8;
    --visor-relleno: #2c2e33;
    --visor-arista: #9aa0a8;
    --visor-resalte: #f4f4f5;
    --visor-resalte-arista: #a1a1aa;
    --visor-acento: #e4e4e7;
    --visor-sobre-acento: #18181b;
    --visor-borde: rgba(255, 255, 255, 0.13);
    --visor-fondo: #25252a;
    --visor-texto: #f4f4f5;
    --visor-suave: #a1a1aa;
  }
  .visor button { cursor: pointer; }

  .visor-expediente, .visor-etiqueta, .visor-ayuda, .visor-respaldo,
  .visor-silueta-nombre, .visor-fuente-medio, .visor-fuente-respalda,
  .visor-letra, .visor-pin, .visor-rotulo {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
  }
  .visor-etiqueta, .visor-expediente, .visor-silueta-nombre, .visor-respaldo, .visor-fuente-medio {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Cabecera: país, nombre y, a la derecha, el crédito. */
  .visor-cab {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px dashed var(--visor-borde);
  }
  .visor-expediente { display: flex; align-items: center; gap: 0.55rem; color: var(--visor-suave); }
  .visor-bandera svg { display: block; width: 22px; height: auto; image-rendering: pixelated; shape-rendering: crispEdges; }
  .visor-titulo { font-size: 1.7rem; font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; }
  .visor-subtitulo { font-size: 0.9rem; color: var(--visor-suave); }
  /* A la derecha, a media altura de la cabecera. */
  .visor-credito {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: 0.75rem;
    font-size: 0.66rem;
    line-height: 1.6;
    text-align: right;
    color: var(--visor-suave);
  }
  .visor-credito a { color: inherit; text-decoration: underline; text-decoration-color: var(--visor-borde); }
  .visor-credito a:hover { color: var(--visor-acento); }
  .visor-credito-icono { display: inline-block; margin-right: 0.25rem; vertical-align: -0.15em; }
  .visor-credito-icono svg { display: block; width: 0.8rem; height: 0.8rem; }

  .visor-cuerpo { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; }
  .visor-escena { min-width: 0; border-right: 1px solid var(--visor-borde); }

  .visor-lienzo-caja {
    position: relative;
    overflow: hidden;
    height: 26rem;
    background-image:
      linear-gradient(var(--visor-borde) 1px, transparent 1px),
      linear-gradient(90deg, var(--visor-borde) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: center;
  }
  .visor-lienzo { display: block; width: 100%; height: 100%; cursor: grab; touch-action: none; }
  .visor-lienzo:active { cursor: grabbing; }
  .visor-lienzo:focus-visible { outline: 2px solid var(--visor-acento); outline-offset: -2px; }
  .visor-pines { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .visor-guia { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .visor-guia line { stroke: var(--visor-acento); stroke-width: 1; }
  .visor-ayuda { position: absolute; right: 0.9rem; bottom: 0.7rem; color: var(--visor-suave); font-size: 0.6rem; letter-spacing: 0.08em; }
  .visor-sin-webgl-aviso { display: none; }
  .visor.visor-sin-webgl .visor-sin-webgl-aviso {
    display: grid; place-items: center; position: absolute; inset: 0; padding: 2rem; text-align: center;
  }

  /* Chinchetas: una letra en una etiqueta cuadrada. */
  .visor-pin, .visor-letra {
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    border: 1px solid currentColor;
    border-radius: 2px;
    font-size: 0.68rem;
    font-weight: 600;
  }
  .visor-pin {
    position: absolute;
    left: -0.625rem;
    top: -0.625rem;
    pointer-events: auto;
    background: var(--visor-fondo);
    color: var(--visor-tinta);
    transition: opacity 0.15s;
  }
  .visor-pin:hover, .visor-pin--elegido {
    background: var(--visor-acento);
    border-color: var(--visor-acento);
    color: var(--visor-sobre-acento);
  }
  .visor-pin--tapado { opacity: 0.3; }
  .visor-rotulo {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--visor-acento);
    background: var(--visor-fondo);
    color: var(--visor-texto);
    font-size: 0.72rem;
    white-space: nowrap;
  }
  .visor:not(.visor-listo) .visor-pines, .visor:not(.visor-listo) .visor-guia { visibility: hidden; }

  /* Tira de siluetas: son los botones de vista. La silueta es una máscara
     (la pinta el script), así toma el color de la tinta de día y de noche. */
  .visor-barra {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    border-top: 1px solid var(--visor-borde);
  }
  .visor-siluetas { display: flex; gap: 0.4rem; }
  .visor-siluetas button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.35rem 0.5rem 0.25rem;
    border: 1px solid transparent;
    border-radius: 3px;
    color: var(--visor-suave);
  }
  .visor-silueta {
    display: block;
    width: 64px;
    height: 32px;
    background: currentColor;
    mask-size: contain;
    mask-position: center;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
  }
  .visor-siluetas button:hover { color: var(--visor-texto); }
  .visor-siluetas button[aria-pressed="true"] { border-color: var(--visor-acento); color: var(--visor-acento); }
  .visor-herramientas { display: flex; gap: 0.2rem; }
  .visor-herramientas button {
    padding: 0.25rem 0.6rem;
    border: 1px solid transparent;
    border-radius: 3px;
    font-size: 0.8rem;
    color: var(--visor-suave);
  }
  .visor-herramientas button:hover { color: var(--visor-texto); }
  .visor-herramientas button[aria-pressed="true"] { border-color: var(--visor-acento); color: var(--visor-acento); }

  /* Panel: la lista de partes y la ficha de la elegida. */
  .visor-panel { position: relative; min-width: 0; }
  .visor-pestanas { display: flex; gap: 1.2rem; padding: 0 1.1rem; border-bottom: 1px solid var(--visor-borde); }
  .visor-pestanas button {
    padding: 0.8rem 0 0.6rem;
    border-bottom: 2px solid transparent;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--visor-suave);
  }
  .visor-pestanas button span { opacity: 0.7; }
  .visor-pestanas button:hover { color: var(--visor-texto); }
  .visor-pestanas button[aria-selected="true"] { border-bottom-color: var(--visor-acento); color: var(--visor-texto); }
  /* La hoja ocupa el alto de la escena y, si no cabe, se desplaza. */
  .visor-hoja { position: absolute; inset: 2.6rem 0 0; overflow-y: auto; padding: 1rem 1.1rem; }
  .visor-etiqueta { color: var(--visor-suave); margin-bottom: 0.6rem; }
  .visor-lista button {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.28rem 0;
    font-size: 0.88rem;
    text-align: left;
    color: var(--visor-texto);
  }
  .visor-lista button:hover { color: var(--visor-acento); }
  /* La parte elegida: casilla rellena en tinta y nombre en negrita. */
  .visor-lista button[aria-pressed="true"] { font-weight: 600; }
  .visor-lista button[aria-pressed="true"] .visor-letra {
    background: var(--visor-acento);
    border-color: var(--visor-acento);
    color: var(--visor-sobre-acento);
  }
  .visor-ficha { margin-top: 1rem; padding-top: 0.9rem; border-top: 1px dashed var(--visor-borde); }
  .visor-respaldo { color: var(--visor-suave); }
  .visor-respaldo--foto { color: var(--visor-acento); }
  .visor-ficha-nombre { display: flex; align-items: center; gap: 0.5rem; margin: 0.4rem 0; font-weight: 600; }
  .visor-ficha-texto { font-size: 0.88rem; line-height: 1.55; }
  .visor-ficha-nota { margin-top: 0.5rem; font-size: 0.8rem; font-style: italic; color: var(--visor-suave); }
  .visor-ficha-fuentes { margin-top: 0.6rem; font-size: 0.78rem; color: var(--visor-acento); }
  .visor-ficha-fuentes:hover { text-decoration: underline; }
  .visor-estilo { display: flex; margin-right: 0.6rem; border: 1px solid var(--visor-borde); border-radius: 3px; }
  .visor-herramientas .visor-estilo button { border: 0; border-radius: 0; }
  .visor-herramientas .visor-estilo button[aria-pressed="true"] { background: var(--visor-acento); color: var(--visor-sobre-acento); }
  .visor-herramientas button:disabled { opacity: 0.45; cursor: not-allowed; }

  /* Fuentes, en su pestaña: miniatura a la izquierda, texto a la derecha. */
  .visor-hoja-intro { margin-bottom: 0.7rem; font-size: 0.8rem; color: var(--visor-suave); }
  .visor-fuentes-lista { display: flex; flex-direction: column; gap: 0.7rem; }
  .visor-fuentes-lista li { transition: opacity 0.2s; }
  .visor-fuentes-lista a { display: flex; gap: 0.65rem; color: inherit; text-decoration: none; }
  .visor-fuentes-lista img, .visor-fuente-icono {
    flex: none;
    width: 4.5rem;
    height: 3rem;
    object-fit: cover;
    border: 1px solid var(--visor-borde);
  }
  .visor-fuentes-lista img { filter: grayscale(0.35); transition: filter 0.2s; }
  .visor-fuentes-lista a:hover img { filter: none; }
  .visor-fuente-icono { display: grid; place-items: center; border-style: dashed; color: var(--visor-suave); font-size: 1.1rem; }
  .visor-fuente-texto { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .visor-fuente-medio { font-size: 0.6rem; }
  .visor-fuente-titulo { font-size: 0.78rem; line-height: 1.3; }
  .visor-fuentes-lista a:hover .visor-fuente-titulo { color: var(--visor-acento); }
