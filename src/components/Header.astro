---
import Container from "@components/Container.astro";
import ThemeToggle from "@components/ThemeToggle.astro";
import { SITE } from "@consts";
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between items-center">
      <!-- El logo va de fondo (.logo-home en base.css) y no como <img>: así
           solo se baja el SVG del tema activo (88 KB el de día, 154 KB el de
           noche). -->
      <a href="/" aria-label={SITE.NAME} class="logo-home"></a>
      <!-- Sin menú: a cada sección se llega desde la portada. -->
      <ThemeToggle />
    </div>
  </Container>
</header>
