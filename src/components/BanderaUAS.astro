---
// Bandera del país de un dron del hangar de UAS: la chapa en pixel art de su
// maqueta (svgBandera), como en /luna y /marte. Sale en los filtros y las
// tarjetas de /uas, la cabecera del visor y los rótulos de la tira de la
// portada. El usuario la eligió frente al emoji el 29-sep-2026 (además,
// Windows no pinta las banderas emoji: salen dos letras). Si el dron aún no
// tiene maqueta, el emoji. El tamaño, en base.css.
import type { Maqueta } from "../data/uas/tipos";
import { svgBandera } from "../data/alunizajes";

type Props = { modelo: string; emoji?: string };
const { modelo, emoji } = Astro.props;

const todas = import.meta.glob<{ default: Maqueta }>(["../data/uas/*.ts", "!../data/uas/tipos.ts"], { eager: true });
const m = todas[`../data/uas/${modelo}.ts`]?.default;
---

{m ? <span class="bandera-uas" set:html={svgBandera(m.pais)} /> : emoji && <span>{emoji}</span>}
