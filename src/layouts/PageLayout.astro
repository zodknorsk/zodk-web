---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  // "hero" activa la portada a pantalla completa: se pinta el slot "hero"
  // a sangre entre la cabecera y <main>, y <html> lleva la clase "home"
  // (para que la cabecera sea transparente sobre el planeta hasta el scroll).
  hero?: boolean;
  // Sin cabecera (logo, notas / eventos, día/noche): /luna, donde no pinta
  // nada (la Luna no cambia con el tema) y estorba a la escena.
  cabecera?: boolean;
};

const { title, description, hero = false, cabecera = true } = Astro.props;
---

<!doctype html>
<html lang="es" class={hero ? "home at-top" : undefined}>
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
  </head>
  <body>
    {cabecera && <Header />}
    {hero && <slot name="hero" />}
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
