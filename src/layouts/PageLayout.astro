---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  // Astro a pantalla completa (portada, /luna, /marte): el slot "hero" va a
  // sangre antes de <main> y <html> lleva la clase "home".
  hero?: boolean;
  // Sin cabecera: la portada, /luna y /marte, con sus propios botones.
  cabecera?: boolean;
};

const { title, description, hero = false, cabecera = true } = Astro.props;
---

<!doctype html>
<html lang="es" class={hero ? "home" : undefined}>
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
  </head>
  <body>
    {cabecera && <Header title={title} />}
    {hero && <slot name="hero" />}
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
