---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  // Portada a pantalla completa: el slot "hero" va a sangre entre la
  // cabecera y <main>, y <html> lleva la clase "home" (cabecera transparente
  // sobre el planeta hasta hacer scroll).
  hero?: boolean;
  // Sin cabecera: /luna y /marte, a pantalla completa con sus propios botones.
  cabecera?: boolean;
};

const { title, description, hero = false, cabecera = true } = Astro.props;
---

<!doctype html>
<html lang="es" class={hero ? "home at-top" : undefined}>
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
  </head>
  <body>
    {cabecera && <Header />}
    {hero && <slot name="hero" />}
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
