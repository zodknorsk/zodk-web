---
// Listado de eventos. Cada evento tiene un archivo "index" (kind === "index").
// Ruta: /eventos
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { EVENTOS } from "@consts";
import TiraCabecera from "@components/TiraCabecera.astro";
import { enCurso, porFecha } from "@lib/contenido";

const todos = await getCollection("eventos");

const eventos = todos
  .filter((e) => e.data.kind === "index" && !e.data.draft)
  .sort(porFecha)
  .map((ev) => ({
    ev,
    semanas: todos.filter(
      (x) =>
        x.data.evento === ev.data.evento &&
        x.data.kind === "semana" &&
        !x.data.draft,
    ).length,
  }));
const nSemanas = eventos.reduce((n, e) => n + e.semanas, 0);
const nEnCurso = eventos.filter(({ ev }) => enCurso(ev.data.periodo)).length;
const pie = [
  `${eventos.length} evento${eventos.length === 1 ? "" : "s"}`,
  nSemanas && `${nSemanas} semana${nSemanas === 1 ? "" : "s"} de seguimiento`,
  nEnCurso && `${nEnCurso} en curso`,
].filter(Boolean).join(" · ");
---

<PageLayout title={EVENTOS.TITLE} description={EVENTOS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <TiraCabecera titulo="Eventos" desc="Seguimiento de eventos, actuales e históricos." pie={pie}>
        {/* El piloto de «en curso», como el sello de la portada: late en rojo
            si hay algún evento en curso. */}
        <span class="ev-curso">
          <i class={nEnCurso ? "ev-vivo" : undefined} />
          {nEnCurso ? <>EN<br />CURSO</> : <>ARCHI<br />VO</>}
        </span>
      </TiraCabecera>
      <ul class="flex flex-col gap-4">
        {
          eventos.map(({ ev, semanas }) => (
            <li class="animate">
              <a
                href={`/eventos/${ev.data.evento}`}
                class="group flex flex-col gap-1 py-3 px-4 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
              >
                <div class="font-semibold group-hover:text-[#2576eb] dark:group-hover:text-[#649fff]">{ev.data.title}</div>
                {ev.data.description && (
                  <div class="text-sm">{ev.data.description}</div>
                )}
                <div class="text-xs opacity-60 pt-1">
                  {semanas === 0 && ev.data.periodo ? (
                    ev.data.periodo
                  ) : (
                    <>
                      Desde <FormattedDate date={ev.data.date} />
                      {semanas > 0 && (
                        <>
                          {" "}· {semanas} semana{semanas === 1 ? "" : "s"}
                        </>
                      )}
                    </>
                  )}
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>

<style>
  .ev-curso { display: flex; flex-direction: column; align-items: center; gap: 0.45rem; font-size: 0.8rem; line-height: 1.15; text-align: center; letter-spacing: 0.06em; }
  .ev-curso i { width: 10px; height: 10px; border-radius: 50%; background: currentColor; opacity: 0.35; }
  .ev-curso i.ev-vivo { background: #e5484d; opacity: 1; animation: ev-latido 1.6s ease-in-out infinite; }
  @keyframes ev-latido { 50% { opacity: 0.25; } }
  @media (prefers-reduced-motion: reduce) { .ev-curso i.ev-vivo { animation: none; } }
</style>

