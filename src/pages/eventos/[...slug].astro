---
// Las direcciones viejas de /eventos/…: las del seguimiento redirigen a
// /seguimiento/… y las de las operaciones, a /operaciones/<slug>.
import { getCollection } from "astro:content";
import Redireccion from "@components/Redireccion.astro";

export async function getStaticPaths() {
  const seguimientos = (await getCollection("seguimientos")).filter((e) => !e.data.draft);
  const ops = (await getCollection("operaciones")).filter((o) => !o.data.draft);
  return [
    ...seguimientos.map((e) => ({ params: { slug: e.id }, props: { a: `/seguimiento/${e.id}` } })),
    ...ops.map((o) => ({ params: { slug: o.id }, props: { a: `/operaciones/${o.id}` } })),
  ];
}

const { a } = Astro.props;
---

<Redireccion a={a} />
