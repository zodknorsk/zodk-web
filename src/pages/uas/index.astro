---
// /uas: el hangar de UAS (la gran enciclopedia de los UAS). Las tiras del
// glosario y del armamento y una tarjeta por ficha, con la miniatura en pixel art del dron (arte/generar-uas-miniaturas.mjs),
// su país, nombre y categoría, y un filtro por país (sale de la tabla de
// características de cada ficha).
import fs from "node:fs";
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";
import BanderaUAS from "@components/BanderaUAS.astro";
import { porFecha } from "@lib/contenido";
import { gruposDeMuniciones } from "@lib/armamento";

const todas = (await getCollection("uas")).filter((f) => !f.data.draft);
const fichas = todas.filter((f) => !f.data.glosario && !f.data.armamento && !f.data.municion).sort(porFecha);
// El glosario: una tira encima del filtro, con cuántos términos tiene (cada
// entrada es un punto de lista de primer nivel que empieza en negrita).
const glosario = todas.find((f) => f.data.glosario);
const nTerminos = glosario ? (glosario.body ?? "").match(/^- \*\*/gm)?.length ?? 0 : 0;
// El armamento: otra tira debajo, con unas cuantas municiones de ejemplo.
const armamento = todas.find((f) => f.data.armamento);
const municiones = gruposDeMuniciones(todas).flatMap((g) => g.municiones.map((f) => f.data.title));
// El dron de cada tarjeta, de día y de noche, como variables para el CSS. Los
// drones con HD, su imagen en pixel HD (arte/generar-uas-miniaturas-hd.mjs),
// a 1 px por píxel como el visor; los demás, el primer fotograma de su tira
// 1.0 (arte/generar-uas-miniaturas.mjs), al doble.
const conHD = (id: string) => fs.existsSync(`public/uas/${id}/tarjeta.png`);
const conGiro = (id: string) => conHD(id) || fs.existsSync(`public/uas/${id}/giro-planta.png`);
const giros = (id: string) => conHD(id)
  ? `--giro:url(/uas/${id}/tarjeta.png);--giro-noche:url(/uas/${id}/tarjeta-noche.png)`
  : `--giro:url(/uas/${id}/giro-planta.png);--giro-noche:url(/uas/${id}/giro-planta-noche.png)`;

// Valores de un filtro con cuántas fichas tiene cada uno, de más a menos.
function recuento(de: (f: (typeof fichas)[number]) => string | undefined) {
  const n = new Map<string, number>();
  for (const f of fichas) {
    const v = de(f);
    if (v) n.set(v, (n.get(v) ?? 0) + 1);
  }
  return [...n].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "es"));
}
const banderas = new Map(fichas.map((f) => [f.data.pais, f.data.bandera]));
// Una ficha de cada país, para sacar la bandera en pixel art de su maqueta.
const modeloDe = new Map(fichas.map((f) => [f.data.pais, f.id]));
const paises = recuento((f) => f.data.pais);
---

<PageLayout title="Hangar de UAS" description="La gran enciclopedia de los UAS: fichas de drones militares a partir de fuentes abiertas, con una maqueta para girarlos.">
  <Container>
    <div class="space-y-8">
      <div class="animate">
        <BackToPrev href="/">Volver a la portada</BackToPrev>
      </div>
      <h1 class="animate font-semibold text-black dark:text-white">Hangar de UAS</h1>

      {fichas.length === 0 ? (
        <p class="animate">Todavía no hay fichas.</p>
      ) : (
        <>
          <div class="uas-tiras">
          {glosario && (
            <a href={`/uas/${glosario.id}`} class="animate uas-glosario">
              <span class="uas-glosario-letras" aria-hidden="true">A–Z</span>
              <span class="uas-glosario-texto">
                <span class="uas-glosario-titulo">{glosario.data.title}</span>
                <span class="uas-glosario-desc">UAS, MTOW, CCA, GPS-denied, one-way attack drone…</span>
                <span class="uas-glosario-desc"><span class="uas-cuenta" data-n={nTerminos} style={`--cifras:${String(nTerminos).length}`}>{nTerminos}</span> términos para leer las fichas.</span>
              </span>
              <span class="uas-glosario-flecha" aria-hidden="true">→</span>
            </a>
          )}

          {armamento && (
            <a href={`/uas/${armamento.id}`} class="animate uas-glosario">
              <span class="uas-glosario-letras uas-armamento-letras" aria-hidden="true">AGM<br />GBU</span>
              <span class="uas-glosario-texto">
                <span class="uas-glosario-titulo">{armamento.data.title}</span>
                <span class="uas-glosario-desc">{municiones.slice(0, 4).join(", ")}{municiones.length > 4 && "…"}</span>
                <span class="uas-glosario-desc"><span class="uas-cuenta" data-n={municiones.length} style={`--cifras:${String(municiones.length).length}`}>{municiones.length}</span> bombas o misiles disponibles en la armería.</span>
              </span>
              <span class="uas-glosario-flecha" aria-hidden="true">→</span>
            </a>
          )}
          </div>

          <div class="animate space-y-2">
            <div class="uas-filtros" data-filtro="pais" role="group" aria-label="Filtrar por país">
              <span class="uas-filtros-titulo">País</span>
              <button type="button" data-valor="" aria-pressed="true">Todos <span>{fichas.length}</span></button>
              {paises.map(([p, n]) => (
                <button type="button" data-valor={p} aria-pressed="false">
                  {banderas.get(p) && <span class="uas-bandera"><BanderaUAS modelo={modeloDe.get(p)!} emoji={banderas.get(p)} /></span>}{p} <span>{n}</span>
                </button>
              ))}
            </div>
          </div>

          <ul class="animate uas-tarjetas">
            {fichas.map((f) => (
              <li data-pais={f.data.pais ?? ""} data-categoria={f.data.categoria ?? ""}>
                <a href={`/uas/${f.id}`} class="uas-tarjeta">
                  <span class="uas-tarjeta-foto">
                    {conGiro(f.id) && <span class:list={["uas-giro", { "uas-giro--hd": conHD(f.id) }]} style={giros(f.id)} role="img" aria-label={f.data.title}></span>}
                  </span>
                  <span class="uas-tarjeta-texto">
                    <span class="uas-tarjeta-pais"><span class="uas-tarjeta-bandera"><BanderaUAS modelo={f.id} emoji={f.data.bandera} /></span> {f.data.pais}{f.data.tags.includes("prototipo") && <span class="uas-tarjeta-sello">Prototipo</span>}</span>
                    <span class="uas-tarjeta-nombre">{f.data.title}</span>
                    {f.data.categoria && <span class="uas-tarjeta-categoria">{f.data.categoria}</span>}
                    {f.data.description && <span class="uas-tarjeta-desc">{f.data.description}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="animate uas-vacio" hidden>No hay fichas con esos filtros.</p>
        </>
      )}
    </div>
  </Container>
</PageLayout>

<script>
  // Cuántos términos y municiones hay, en una chapa que cuenta desde 0 al
  // cargar la página, en 3 s (con 1,6 s casi no se veía subir mientras
  // aparece la página). Sin animación si se piden menos movimientos.
  document.addEventListener("astro:page-load", () => {
    const cuentas = [...document.querySelectorAll<HTMLElement>(".uas-cuenta")];
    if (!cuentas.length || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const t0 = performance.now();
    const paso = (t: number) => {
      const k = Math.min(1, (t - t0) / 3000);
      const suave = 1 - (1 - k) ** 3;
      for (const el of cuentas) el.textContent = String(Math.round(Number(el.dataset.n) * suave));
      if (k < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  });

  // Filtro por país (el código admite más grupos de filtros a la vez).
  document.addEventListener("astro:page-load", () => {
    const grupos = [...document.querySelectorAll<HTMLElement>(".uas-filtros")];
    if (!grupos.length) return;
    const elegido: Record<string, string> = {};
    const aplicar = () => {
      let quedan = 0;
      document.querySelectorAll<HTMLElement>(".uas-tarjetas li").forEach((li) => {
        const si = Object.entries(elegido).every(([filtro, valor]) => !valor || li.dataset[filtro] === valor);
        li.hidden = !si;
        if (si) quedan++;
      });
      const vacio = document.querySelector(".uas-vacio") as HTMLElement | null;
      if (vacio) vacio.hidden = quedan !== 0;
      // Con un país elegido, las tarjetas lo marcan.
      document.querySelector(".uas-tarjetas")?.classList.toggle("uas-tarjetas--filtro", !!elegido.pais);
    };
    for (const g of grupos) {
      g.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button");
        if (!b) return;
        g.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        elegido[g.dataset.filtro!] = b.dataset.valor ?? "";
        aplicar();
      });
    }
  });
</script>

<style>
  .uas-filtros-titulo, .uas-tarjeta-pais, .uas-tarjeta-categoria {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .uas-tiras { display: flex; flex-direction: column; gap: 0.75rem; }
  /* La chapa del número de términos y de municiones, como el filtro elegido;
     cuenta desde 0 al cargar (el script de abajo), con el ancho fijo del
     número final (--cifras) para que no baile. */
  .uas-cuenta {
    display: inline-block; min-width: calc(var(--cifras, 1) * 1ch + 0.8em); margin-right: 0.1rem; padding: 0.05rem 0.4rem; border-radius: 3px;
    background: #27272a; color: #fafafa; font: 600 0.78rem/1.3 "IBM Plex Mono", monospace; text-align: center;
    font-variant-numeric: tabular-nums;
  }
  :global(html.dark) .uas-cuenta { background: #e4e4e7; color: #18181b; }


  /* Tiras del glosario y del armamento: como una tarjeta tumbada, con la cuadrícula del
     visor a la izquierda. */
  .uas-glosario {
    display: flex;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.13);
    border-radius: 4px;
    background: #ebebee;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  :global(html.dark) .uas-glosario { border-color: rgba(255, 255, 255, 0.13); background: #25252a; }
  .uas-glosario:hover { border-color: #27272a; box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.35); }
  :global(html.dark) .uas-glosario:hover { border-color: #e4e4e7; }
  .uas-glosario-letras {
    display: grid;
    place-items: center;
    flex: none;
    width: 6rem;
    border-right: 1px dashed rgba(0, 0, 0, 0.13);
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.07) 1px, transparent 1px);
    background-size: 16px 16px;
    background-position: center;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 1.1rem;
    font-weight: 600;
    color: #18181b;
  }
  :global(html.dark) .uas-glosario-letras {
    border-right-color: rgba(255, 255, 255, 0.13);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    color: #f4f4f5;
  }
  .uas-glosario-texto { display: flex; flex: 1; flex-direction: column; gap: 0.2rem; padding: 0.85rem 1rem; }
  .uas-glosario-titulo { font-size: 1.05rem; font-weight: 600; color: #18181b; }
  :global(html.dark) .uas-glosario-titulo { color: #f4f4f5; }
  .uas-glosario-desc { font-size: 0.82rem; line-height: 1.45; }
  .uas-glosario-flecha { align-self: center; padding: 0 1.1rem; font-size: 1.1rem; transition: transform 0.2s; }
  .uas-glosario:hover .uas-glosario-flecha { transform: translateX(3px); }
  @media (max-width: 480px) { .uas-glosario-letras { width: 4rem; font-size: 0.95rem; } }
  /* Armamento: los prefijos de misiles (AGM) y bombas guiadas (GBU), en dos
     líneas, como el «A–Z» del glosario. */
  .uas-armamento-letras { line-height: 1.15; text-align: center; letter-spacing: 0.04em; }

  .uas-filtros { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .uas-filtros-titulo { width: 3.2rem; font-size: 0.62rem; opacity: 0.6; }
  .uas-filtros button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 999px;
    font-size: 0.8rem;
  }
  :global(html.dark) .uas-filtros button { border-color: rgba(255, 255, 255, 0.2); }
  .uas-filtros button > span:last-child { opacity: 0.55; font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 0.72rem; }
  .uas-filtros button[aria-pressed="true"] { background: #27272a; border-color: #27272a; color: #fafafa; }
  :global(html.dark) .uas-filtros button[aria-pressed="true"] { background: #e4e4e7; border-color: #e4e4e7; color: #18181b; }
  .uas-bandera { font-size: 0.95rem; line-height: 1; }

  /* El hangar va más ancho que el resto de la web (860 px en vez de 720),
     cabecera incluida, para que quepan tres tarjetas por fila con el dron a
     su tamaño (256 px). */
  :global(body:has(.uas-tarjetas) .max-w-\[720px\]) { max-width: 860px; }

  /* Tarjetas: la miniatura sobre la cuadrícula del visor y, debajo, el texto. */
  .uas-tarjetas { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1rem; }
  .uas-tarjeta {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.13);
    border-radius: 4px;
    background: #ebebee;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  :global(html.dark) .uas-tarjeta { border-color: rgba(255, 255, 255, 0.13); background: #25252a; }
  .uas-tarjeta:hover { border-color: #27272a; box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.35); }
  :global(html.dark) .uas-tarjeta:hover { border-color: #e4e4e7; }
  .uas-tarjeta-foto {
    display: grid;
    place-items: center;
    height: 9.5rem;
    border-bottom: 1px dashed rgba(0, 0, 0, 0.13);
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.07) 1px, transparent 1px);
    background-size: 16px 16px;
    background-position: center;
  }
  :global(html.dark) .uas-tarjeta-foto {
    border-bottom-color: rgba(255, 255, 255, 0.13);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
  }
  /* El dron, quieto (el giro hasta verse de planta al pasar el ratón se
     quitó el 1-oct-2026, a petición del usuario). Con HD, su imagen de
     256x144 a 1 px por píxel, como el visor, casi de perfil; sin HD, el
     primer fotograma de su tira 1.0 (8 de 128x72), al doble. */
  .uas-giro {
    display: block;
    width: 256px;
    height: 144px;
    background: var(--giro) 0 0 / 2048px 144px no-repeat;
    image-rendering: pixelated;
  }
  .uas-giro--hd { background-size: 256px 144px; }
  :global(html.dark) .uas-giro { background-image: var(--giro-noche); }
  .uas-tarjeta-texto { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.85rem 1rem 1rem; }
  /* País: resalta al pasar el ratón y, con un filtro puesto, siempre. */
  .uas-tarjeta-pais { font-size: 0.62rem; opacity: 0.7; transition: opacity 0.2s; }
  .uas-tarjeta-bandera { display: inline-block; transition: transform 0.2s; }
  .uas-tarjeta:hover .uas-tarjeta-pais, .uas-tarjetas--filtro .uas-tarjeta-pais { opacity: 1; font-weight: 600; color: #18181b; }
  :global(html.dark) .uas-tarjeta:hover .uas-tarjeta-pais, :global(html.dark) .uas-tarjetas--filtro .uas-tarjeta-pais { color: #f4f4f5; }
  .uas-tarjeta:hover .uas-tarjeta-bandera, .uas-tarjetas--filtro .uas-tarjeta-bandera { transform: scale(1.35); }
  .uas-tarjetas--filtro .uas-tarjeta-pais { align-self: flex-start; padding: 0.1rem 0.4rem; border-radius: 3px; background: #27272a; color: #fafafa; }
  :global(html.dark) .uas-tarjetas--filtro .uas-tarjeta-pais { background: #e4e4e7; color: #18181b; }
  .uas-tarjeta-sello {
    margin-left: 0.5rem;
    padding: 0.08rem 0.4rem;
    border: 1px solid currentColor;
    border-radius: 2px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .uas-tarjeta-nombre { font-size: 1.05rem; font-weight: 600; color: #18181b; }
  :global(html.dark) .uas-tarjeta-nombre { color: #f4f4f5; }
  .uas-tarjeta-categoria { font-size: 0.62rem; opacity: 0.7; }
  .uas-tarjeta-desc { margin-top: 0.35rem; font-size: 0.82rem; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>

