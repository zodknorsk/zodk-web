---
// Ficha de un dron de la enciclopedia de UAS: /uas/<slug>. Es una nota de la
// carpeta «Hangar de UAS» de la bóveda (también el glosario, con su índice;
// el armamento, con una fila por munición, y cada munición, en
// /uas/armamento/<slug>, con sus fotos en carrusel). Si hay maqueta
// (src/data/uas/<slug>.ts), el importador deja un hueco en su sección
// «Visor» y aquí se pone el visor (docs/uas.md).
import { type CollectionEntry, getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import BackToPrev from "@components/BackToPrev.astro";
import GlosarioTarjeta from "@components/GlosarioTarjeta.astro";
import VisorUAS from "@components/VisorUAS.astro";
import GlosarioIndice from "@components/GlosarioIndice.astro";
import ArmamentoLista from "@components/ArmamentoLista.astro";
import Carrusel from "@components/Carrusel.astro";
import { readingTime } from "@lib/utils";
import { leerGlosario } from "@lib/glosario";
import { gruposDeMuniciones } from "@lib/armamento";

export async function getStaticPaths() {
  const fichas = (await getCollection("uas")).filter((f) => !f.data.draft);
  return fichas.map((ficha) => ({ params: { slug: ficha.id }, props: ficha }));
}
type Props = CollectionEntry<"uas">;

const ficha = Astro.props;
const { Content } = await render(ficha);

const maquetas = Object.keys(import.meta.glob("../../data/uas/*.ts"));
// El visor va dentro del texto, en el hueco, desde el build: si lo pusiera
// un script al cargar, la página crecería por encima de lo que se lee y al
// volver atrás no quedaría donde estaba.
const HUECO = "<div class=\"visor-hueco\"></div>";
const html = ficha.rendered?.html ?? "";
const conVisor = html.includes(HUECO) && maquetas.some((m) => m.endsWith(`/${ficha.id}.ts`));
const [antesDelVisor, trasElVisor] = conVisor ? html.split(HUECO) : [];
const cuerpo = ficha.body ?? "";
const indice = ficha.data.glosario ? { secciones: leerGlosario(cuerpo) } : null;
const grupos = ficha.data.armamento ? gruposDeMuniciones(await getCollection("uas")) : null;
const volver = ficha.data.municion
  ? { href: "/uas/armamento", texto: "Volver al armamento" }
  : { href: "/uas", texto: "Volver a la enciclopedia" };
---

<PageLayout title={ficha.data.title} description={ficha.data.description ?? ""}>
  <Container>
    <div class="animate">
      <BackToPrev href={volver.href}>{volver.texto}</BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5 font-mono">
        <div class="text-sm">
          <FormattedDate date={ficha.data.date} />
        </div>
        &bull;
        <div class="text-sm">{readingTime(ficha.body ?? "")}</div>
      </div>
      <h1 class="animate text-2xl font-semibold text-black dark:text-white">
        {ficha.data.title}
      </h1>
      {
        ficha.data.tags.length > 0 && (
          <div class="animate flex flex-wrap gap-1.5 pt-1 text-sm">
            {ficha.data.tags.map((tag) => (
              <span class="opacity-75">#{tag}</span>
            ))}
          </div>
        )
      }
    </div>
    {indice && <GlosarioIndice {...indice} />}
    <article class="animate">
      {conVisor ? (
        <>
          <Fragment set:html={antesDelVisor} />
          <div class="visor-ancho not-prose">
            <VisorUAS modelo={ficha.id} />
          </div>
          <Fragment set:html={trasElVisor} />
        </>
      ) : (
        <Content />
      )}
    </article>
    {grupos && <ArmamentoLista grupos={grupos} />}
  </Container>
  <GlosarioTarjeta />
  {ficha.data.municion && <Carrusel />}
</PageLayout>

<style>
  /* Más ancho que el texto (720 px), centrado sobre él, hasta 1040 px. */
  .visor-ancho {
    position: relative;
    left: 50%;
    width: min(1040px, calc(100vw - 2.5rem));
    transform: translateX(-50%);
    margin-block: 1.5rem 2rem;
  }
</style>
