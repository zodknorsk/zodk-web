---
// La Luna (ruta "/luna"): la segunda "portada" del Proyecto Luna. Se llega
// desde la Tierra de la portada pulsando la luna de arriba a la izquierda
// (vuelo en index.astro) y siempre se aterriza en la cara visible. El botón
// de abajo a la derecha da media vuelta a la cara oculta y vuelve; el de abajo
// a la izquierda vuelve a la Tierra con el mismo vuelo hacia atrás.
// Motor: src/scripts/luna.js (datos en public/luna/, de
// logo-files/generar-luna.py). Detalle y decisiones en logo-files/LUNA-WIP.md.
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { ALUNIZAJES, PAISES_LUNA, RELES, ORION_NOTA, svgBandera } from "../data/alunizajes";

// Chapas y columna se pintan desde src/data/alunizajes.ts. El sitio de cada
// chapa lo pone el script al llegar (depende de la cara que se vea), así que
// aquí salen ocultas.
const paises = PAISES_LUNA.filter((p) => ALUNIZAJES.some((a) => a.pais === p.codigo));
const porCodigo = Object.fromEntries(PAISES_LUNA.map((p) => [p.codigo, p]));
// La ficha solo enlaza a la nota si está publicada: sin `publicar: true` en la
// bóveda no hay página y el enlace daría 404.
const publicadas = new Set((await getCollection("notas")).map((n) => n.id));
---

<PageLayout title="La Luna" description="La Luna en pixel art: la cara visible y la cara oculta." hero cabecera={false}>
  <section slot="hero" class="hero luna-hero" aria-label="La Luna">
    <div class="hero-stars" aria-hidden="true"></div>
    <!-- Mismo tamaño y sitio que donde termina el vuelo desde la Tierra
         (.luna-disco en global.css). El fondo es la cara visible: se ve sin JS
         y mientras carga el canvas. -->
    <div class="luna-disco" role="img" aria-label="La Luna, cara visible">
      <canvas class="luna-canvas" aria-hidden="true"></canvas>
    </div>
    <!-- Chapas de alunizaje: una por misión, encima del disco. El script las
         coloca (y esconde las de la otra cara) según la cara que se vea. -->
    <div class="luna-chapas">
      {ALUNIZAJES.map((a) => (
        <div
          class="luna-chapa"
          data-pais={a.pais}
          data-clave={a.grupo ? `${a.pais}:${a.grupo}` : a.pais}
          data-cara={a.cara}
          data-lat={a.lat}
          data-lon={a.lon}
          tabindex="0"
          hidden
          aria-label={`${a.nombre} (${porCodigo[a.pais].nombre}, ${a.anio}): ficha de la misión`}
        >
          <Fragment set:html={svgBandera(porCodigo[a.pais])} />
          <div class="craft-dossier">
            <span class="craft-linea" />
            <span class="bandera-puente" />
            <div class="craft-specs">
              <img class="mision-foto" src={`/alunizajes/${a.foto}`} alt="" loading="lazy" width="256" height="256" />
              <div class="craft-specs-titulo">{a.nombre}</div>
              <div class="craft-clase">
                <span class="craft-flag">{porCodigo[a.pais].bandera}</span>
                {porCodigo[a.pais].nombre} · {a.anio}
              </div>
              <p class="mision-texto">{a.texto}</p>
              {publicadas.has(a.nota) && (
                <a class="mision-enlace" href={`/notas/${a.nota}`}>Leer la nota →</a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
    <!-- Relés Queqiao (China): solo en la cara oculta y siempre, sin filtro.
         Flotan sobre la cuenca Polo Sur-Aitken, cada uno bajo la misión a la
         que dio servicio (Queqiao, Chang'e 4; Queqiao-2, Chang'e 6), con una
         deriva pequeña en CSS. Por turnos, una onda sube de la nave a su relé
         y sale hacia la derecha (hacia la Tierra). El script los enseña al
         llegar a la oculta. Ficha al pasar el ratón, como las chapas. -->
    <div class="luna-sats">
      {[1, 2].map((i) => (
        <div class={`luna-onda luna-onda--${i}`} aria-hidden="true">
          {[0, 1, 2, 3, 4].map((k) => <span class="luna-onda-paso" style={`--k:${k}`}><i /></span>)}
        </div>
      ))}
      {RELES.map((r, i) => (
        <div
          class={`luna-sat luna-sat--${i + 1}`}
          style={`background-image:url(/luna/${r.sprite})`}
          tabindex="0"
          aria-label={`${r.nombre} (China, ${r.anio}): ficha del satélite`}
        >
          <div class="craft-dossier">
            <span class="craft-linea" />
            <span class="bandera-puente" />
            <div class="craft-specs">
              <div class="craft-specs-titulo">{r.nombre}</div>
              <div class="craft-clase">
                <span class="craft-flag">🇨🇳</span>
                China · {r.anio} · relé de la {r.sirve}
              </div>
              <p class="mision-texto">{r.texto}</p>
              {publicadas.has(r.nota) && (
                <a class="mision-enlace" href={`/notas/${r.nota}`}>Leer la nota →</a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
    <!-- Orion (Artemis II) orbitando la Luna, en las dos caras: por delante
         de derecha a izquierda y por detrás, tapada por el disco. Gira según
         va: tira de 32 fotogramas public/luna/zodk-orion-giro*.png, de
         logo-files/generar-orion.py.
         Paleta de día en la cara visible y de noche en la oculta. Al pasar
         el ratón se para y sale su ficha, como las de los Queqiao. -->
    <div class="luna-orbitas">
      <div class="luna-nave-x">
        <div class="luna-nave-y">
          <div class="luna-nave" tabindex="0" aria-label="Orion, Artemis II (EE. UU., 2026): ficha de la nave">
            <div class="craft-dossier">
              <span class="craft-linea" />
              <span class="bandera-puente" />
              <div class="craft-specs">
                <div class="craft-specs-titulo">Orion · Artemis II</div>
                <div class="craft-clase">
                  <span class="craft-flag">🇺🇸</span>
                  EE. UU. · 2026 · sobrevuelo tripulado
                </div>
                <p class="mision-texto">
                  En abril de 2026 llevó a cuatro astronautas (Reid Wiseman, Victor Glover, Christina Koch y
                  el canadiense Jeremy Hansen) a rodear la Luna y volver sin alunizar: el primer vuelo
                  tripulado más allá de la órbita terrestre desde el Apolo 17.
                </p>
                {publicadas.has(ORION_NOTA) && (
                  <a class="mision-enlace" href={`/notas/${ORION_NOTA}`}>Leer la nota →</a>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Columna de países: enciende y apaga los alunizajes de cada uno. -->
    <div class="luna-paises" hidden>
      {paises.map((p) => (
        <div class="luna-pais-grupo">
          <button
            class="luna-pais"
            type="button"
            data-pais={p.codigo}
            aria-pressed="false"
            aria-expanded={p.grupos ? "false" : undefined}
          >
            <span class="luna-pais-bandera" set:html={svgBandera(p)} />
            <span class="luna-pais-nombre">{p.nombre}</span>
          </button>
          {p.grupos && (
            <div class="luna-subgrupos" inert>
              <div class="luna-subgrupos-dentro">
                {p.grupos.map((g) => (
                  <button class="luna-subgrupo" type="button" data-pais={p.codigo} data-clave={`${p.codigo}:${g.codigo}`} aria-pressed="false">
                    {g.nombre}
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
    <!-- Menú del Proyecto Luna: enlaces a las notas del blog que dan contexto
         (alunizajes, relés de la cara oculta y Orion). No depende del motor
         ni de JS, así que se pinta siempre (a diferencia de las fichas, que
         necesitan ratón); solo se enlaza si la nota está publicada, como en
         las fichas. Sustituye a la cabecera normal, que aquí no se pinta. -->
    <nav class="luna-menu" aria-label="Proyecto Luna">
      {publicadas.has("alunizajes") && <a href="/notas/alunizajes">alunizajes</a>}
      {publicadas.has("reles-en-la-cara-oculta") && <a href="/notas/reles-en-la-cara-oculta">relés</a>}
      {publicadas.has(ORION_NOTA) && <a href={`/notas/${ORION_NOTA}`}>orion</a>}
    </nav>
    <!-- Botones: volver a la Tierra (HUD, con esquinas doradas como las fichas)
         abajo a la derecha, y el mando de cara abajo en el centro: UN solo
         botón, se pulse donde se pulse cambia de cara; la píldora dorada se
         desliza a la cara nueva a la vez que gira la Luna. -->
    <button class="luna-volver" type="button" aria-label="Volver a la Tierra" hidden>
      <span>volver a la Tierra</span>
      <span class="luna-volver-tierra" aria-hidden="true"></span>
    </button>
    <button class="luna-cambio" type="button" data-cara="visible" hidden>
      <span class="luna-cambio-pildora" aria-hidden="true"></span>
      <span class="luna-cambio-cara luna-cambio-cara--visible"><span class="luna-cambio-icono luna-cambio-icono--visible"></span>cara visible</span>
      <span class="luna-cambio-cara luna-cambio-cara--oculta">cara oculta<span class="luna-cambio-icono luna-cambio-icono--oculta"></span></span>
    </button>
  </section>
  <div id="hero-sentinel" aria-hidden="true"></div>
</PageLayout>

<script>
  // Como el planeta de la portada: la web cambia de página sin recargar
  // (ClientRouter), así que se monta en cada llegada y se desmonta al salir.
  import { navigate } from "astro:transitions/client";
  import { montarLuna, LUNA_V } from "../scripts/luna.js";
  import { volarALuna, faseLunaHoy } from "../scripts/viaje-luna.js";

  type Luna = { girar(): void; cara(): string; girando(): boolean; desmontar(): void };
  let luna: Luna | null = null;
  let quitaBoton: (() => void) | null = null;
  let estrellasTierra: string | null = null;   // posición de las estrellas al aterrizar en la portada

  // Selección de países/chapas y cara: se guarda en sessionStorage para que
  // "Leer la nota" y volver con "Volver a la Luna" (dos navegaciones sueltas,
  // no un atrás/adelante del navegador) la dejen tal cual estaba. Al volver a
  // la Tierra de verdad se borra, para que una llegada nueva desde el hero
  // empiece siempre limpia (como hasta ahora).
  const CLAVE_ESTADO = "luna-estado";
  type EstadoLuna = { encendidos: string[]; cara: string };
  function leerEstadoLuna(): EstadoLuna | null {
    try { return JSON.parse(sessionStorage.getItem(CLAVE_ESTADO) ?? "null"); }
    catch { return null; }
  }
  function guardarEstadoLuna(encendidos: Iterable<string>, cara: string) {
    try { sessionStorage.setItem(CLAVE_ESTADO, JSON.stringify({ encendidos: [...encendidos], cara })); }
    catch { /* sessionStorage no disponible */ }
  }
  function borrarEstadoLuna() {
    try { sessionStorage.removeItem(CLAVE_ESTADO); } catch { /* sessionStorage no disponible */ }
  }

  // Vuelta a la Tierra: el vuelo de la portada hacia atrás (src/scripts/viaje-luna.js).
  // Para saber dónde acaban la luna del hero y la Tierra se ponen aquí un icono
  // y una Tierra con las clases de la portada (mismo sitio y tamaño, y la
  // Tierra del tema que toque); se van con la página al aterrizar.
  async function volverATierra(hero: HTMLElement, l: Luna, disco: HTMLElement, apagar: HTMLElement[]) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return navigate("/");
    const img = new Image();
    img.src = `/luna/luna-${l.cara()}.png?v=${LUNA_V}`;
    await img.decode().catch(() => {});
    const astro = document.createElement("div");
    astro.className = "hero-astro";
    astro.setAttribute("aria-hidden", "true");
    const icono = document.createElement("span");
    icono.className = "astro-luna";
    icono.style.backgroundPosition = faseLunaHoy();
    astro.append(icono);
    const planeta = document.createElement("div");
    planeta.className = "hero-planet";
    planeta.setAttribute("aria-hidden", "true");
    hero.append(astro, planeta);
    const estrellas = hero.querySelector<HTMLElement>(".hero-stars")!;
    const vuelo = volarALuna({
      icono, planeta, estrellas, apagar, img, inverso: true,
      iconoVisible: document.documentElement.classList.contains("dark"),
    });
    disco.style.visibility = "hidden";          // la sustituye la capa del vuelo, en el mismo sitio
    l.desmontar();
    estrellasTierra = await vuelo.fin;
    navigate("/");
  }

  // Al aterrizar en la portada, sus estrellas donde quedaron las del vuelo, y
  // la cabecera (que /luna no tiene) entra con un fundido en vez de de golpe.
  document.addEventListener("astro:after-swap", () => {
    if (estrellasTierra === null) return;
    document.querySelector<HTMLElement>(".hero:not(.luna-hero) .hero-stars")?.style.setProperty("--estrellas-pos", estrellasTierra);
    document.querySelector<HTMLElement>("body > header")?.animate(
      [{ opacity: 0 }, { opacity: 1 }], { duration: 700, easing: "ease-out" },
    );
    estrellasTierra = null;
  });

  const TEXTO: Record<string, string> = {   // aria-label del mando según la cara que se ve
    visible: "Cara visible. Girar la Luna a la cara oculta",
    oculta: "Cara oculta. Girar la Luna a la cara visible",
  };

  document.addEventListener("astro:page-load", async () => {
    const cv = document.querySelector<HTMLCanvasElement>(".luna-canvas");
    const boton = document.querySelector<HTMLButtonElement>(".luna-cambio");
    const volver = document.querySelector<HTMLButtonElement>(".luna-volver");
    const hero = document.querySelector<HTMLElement>(".luna-hero");
    if (!cv || !boton || !volver || !hero) return;
    // Banco de pruebas de consumo de la Orion (?orion=quieta / sin-z / capa),
    // igual que el ?medir de la portada: las reglas están en global.css, junto
    // a la nave. Solo hace algo con el parámetro puesto.
    const orion = new URLSearchParams(location.search).get("orion");
    if (orion) hero.classList.add(`prueba-orion-${orion}`);
    const estadoGuardado = leerEstadoLuna();
    const disco = cv.parentElement as HTMLElement;
    const pon = (cara: string) => {
      boton.dataset.cara = cara;
      boton.setAttribute("aria-label", TEXTO[cara]);
      disco.setAttribute("aria-label", `La Luna, cara ${cara}`);
    };
    // Chapas: mientras gira se esconden todas y al acabar se recolocan en la
    // cara nueva (las de la otra cara se quedan fuera).
    let esconderChapas = () => {};
    let colocarChapas = () => {};
    let soloChina = () => {};
    let guardarSeleccion = () => {};
    const sats = document.querySelector<HTMLElement>(".luna-sats");
    const l = await montarLuna(cv, {
      cara: estadoGuardado?.cara === "oculta" ? "oculta" : "visible",
      alEmpezar: (destino: string) => {
        boton.dataset.cara = destino;   // la píldora se desliza mientras gira
        boton.disabled = volver.disabled = true;
        esconderChapas();
        sats?.classList.remove("en-vista");
      },
      alTerminar: (cara: string) => {
        boton.disabled = volver.disabled = false;
        guardarSeleccion();
        sats?.classList.toggle("en-vista", cara === "oculta");
        hero.classList.toggle("cara-oculta", cara === "oculta");
        pon(cara);
        colocarChapas();
      },
    });
    if (!cv.isConnected) return l.desmontar();   // se salió de la página mientras cargaba
    disco.classList.add("luna-lista");
    luna = l;
    pon(l.cara());
    boton.hidden = volver.hidden = false;

    // --- Chapas de alunizaje y columna de países --------------------------
    const capa = document.querySelector<HTMLElement>(".luna-chapas");
    const columna = document.querySelector<HTMLElement>(".luna-paises");
    const chapas = [...document.querySelectorAll<HTMLElement>(".luna-chapa")];
    const encendidos = new Set<string>(estadoGuardado?.encendidos ?? []);
    if (capa && columna) {
      // La chapa mide 13x9 del lienzo de 600: se resta medio ancho/alto en %
      // (no en px) para que siga centrada al ampliarse el disco.
      const DX = (13 / 600 / 2) * 100, DY = (9 / 600 / 2) * 100;
      // Chapas encendidas a menos de una chapa de distancia (Apolo 12 y
      // Surveyor 3 cayeron a 180 m; Apolo 11 y Surveyor 5, a 4 px) se ponen
      // lado a lado, pegadas y centradas en su punto medio, la más al oeste a
      // la izquierda. Cuentas en píxeles del lienzo de 600.
      const PASO = 14;
      colocarChapas = () => {
        const grupos: { u: number; v: number; els: { el: HTMLElement; u: number }[] }[] = [];
        for (const el of chapas) {
          const p = l.sitio(Number(el.dataset.lat), Number(el.dataset.lon));
          const otraCara = el.dataset.cara && el.dataset.cara !== l.cara();
          el.hidden = !encendidos.has(el.dataset.clave!) || !p.vis || !!otraCara;
          if (el.hidden) continue;
          const u = p.u * 600, v = p.v * 600;
          const g = grupos.find((g) => Math.hypot(g.u - u, g.v - v) < 13);
          if (!g) { grupos.push({ u, v, els: [{ el, u }] }); continue; }
          g.els.push({ el, u });
          g.u += (u - g.u) / g.els.length;
          g.v += (v - g.v) / g.els.length;
        }
        for (const g of grupos) {
          g.els.sort((a, b) => a.u - b.u);
          g.els.forEach(({ el }, i) => {
            const u = g.u + (i - (g.els.length - 1) / 2) * PASO;
            el.style.left = `calc(${(u / 600) * 100}% - ${DX}%)`;
            el.style.top = `calc(${(g.v / 600) * 100}% - ${DY}%)`;
          });
        }
      };
      esconderChapas = () => { for (const el of chapas) el.hidden = true; };
      // Dónde cabe la ficha: al lado que quede sitio, y anclada por su borde si
      // centrada se saldría por arriba o por abajo.
      for (const el of [...chapas, ...document.querySelectorAll<HTMLElement>(".luna-sat, .luna-nave")]) {
        const sitioFicha = () => {
          const r = el.getBoundingClientRect();
          el.classList.toggle("flip-x", r.right + 380 > window.innerWidth);
          const alto = el.querySelector<HTMLElement>(".craft-specs")!.offsetHeight;
          const centro = r.top + r.height / 2;
          el.classList.toggle("ancla-arriba", centro - alto / 2 < 8);
          el.classList.toggle("ancla-abajo", centro + alto / 2 > window.innerHeight - 8);
        };
        el.addEventListener("mouseenter", sitioFicha);
        el.addEventListener("focus", sitioFicha);
      }
      // Un país con subgrupos (EE. UU.) no tiene clave propia: su botón solo
      // despliega o recoge sus casillas (sin encender nada), y se ve encendido
      // mientras quede alguna casilla encendida, también con él recogido.
      const subs = [...columna.querySelectorAll<HTMLButtonElement>(".luna-subgrupo")];
      const pintaBotones = () => {
        for (const b of subs) b.setAttribute("aria-pressed", String(encendidos.has(b.dataset.clave!)));
        for (const b of columna.querySelectorAll<HTMLButtonElement>(".luna-pais")) {
          const suyas = subs.filter((s) => s.dataset.pais === b.dataset.pais);
          const on = suyas.length ? suyas.some((s) => encendidos.has(s.dataset.clave!)) : encendidos.has(b.dataset.pais!);
          b.setAttribute("aria-pressed", String(on));
        }
        // Las ondas nave -> relé -> Tierra salen de Chang'e 4 y 6: con China
        // apagada no hay de dónde salir. Los relés se quedan a la vista.
        sats?.classList.toggle("sin-ondas", !encendidos.has("CN"));
      };
      const pinta = () => { pintaBotones(); colocarChapas(); guardarSeleccion(); };
      guardarSeleccion = () => guardarEstadoLuna(encendidos, l.cara());
      // Al ir a la cara oculta se apaga todo y se enciende China, para que
      // Chang'e 4 y 6 salgan al llegar sin activarlas a mano. Solo botones:
      // las chapas las coloca alTerminar al acabar el giro.
      pintaBotones();
      // Si se vuelve con una selección guardada, sus chapas se pintan ya al
      // montar (si no, solo se colocan tras un clic o un giro).
      if (estadoGuardado?.encendidos.length) colocarChapas();
      // Si se vuelve con algún subgrupo de EE. UU. ya encendido (p. ej. tras
      // leer una nota de Apolo), se despliegan sus casillas de entrada: si no,
      // se verían encendidas pero recogidas, como si no hubiera nada activo.
      for (const b of columna.querySelectorAll<HTMLButtonElement>(".luna-pais")) {
        const grupo = b.parentElement!;
        const cajas = grupo.querySelector<HTMLElement>(".luna-subgrupos");
        if (!cajas) continue;
        const suyas = subs.filter((s) => s.dataset.pais === b.dataset.pais);
        if (!suyas.some((s) => encendidos.has(s.dataset.clave!))) continue;
        grupo.classList.add("abierto");
        b.setAttribute("aria-expanded", "true");
        cajas.inert = false;
      }
      soloChina = () => {
        encendidos.clear();
        for (const b of subs) if (b.dataset.pais === "CN") encendidos.add(b.dataset.clave!);
        encendidos.add("CN");
        pintaBotones();
        guardarSeleccion();
      };
      for (const b of columna.querySelectorAll<HTMLButtonElement>(".luna-pais")) {
        b.addEventListener("click", () => {
          const grupo = b.parentElement!;
          const cajas = grupo.querySelector<HTMLElement>(".luna-subgrupos");
          if (cajas) {
            const abrir = !grupo.classList.contains("abierto");
            grupo.classList.toggle("abierto", abrir);
            b.setAttribute("aria-expanded", String(abrir));
            cajas.inert = !abrir;
            return;
          }
          const c = b.dataset.pais!;
          encendidos.has(c) ? encendidos.delete(c) : encendidos.add(c);
          pinta();
        });
      }
      for (const b of subs) {
        b.addEventListener("click", () => {
          const c = b.dataset.clave!;
          encendidos.has(c) ? encendidos.delete(c) : encendidos.add(c);
          pinta();
          // Si se desmarca la última casilla, el país se recoge solo.
          const grupo = b.closest<HTMLElement>(".luna-pais-grupo")!;
          if (!subs.some((s) => s.dataset.pais === b.dataset.pais && encendidos.has(s.dataset.clave!))) {
            grupo.querySelector<HTMLButtonElement>(".luna-pais")!.click();
          }
        });
      }
      columna.hidden = false;
      // La columna va centrada en vertical; al desplegar las casillas de un
      // país crecería por arriba y por abajo y se movería todo, también el
      // botón que se está señalando. Se fija su borde de arriba donde queda
      // recogida y así solo empuja hacia abajo.
      const fija = () => {
        columna.style.top = columna.style.transform = "";
        columna.style.top = `${columna.offsetTop - columna.offsetHeight / 2}px`;
        columna.style.transform = "none";
      };
      fija();
      new ResizeObserver(() => { if (!columna.querySelector(".abierto")) fija(); }).observe(hero);
    }

    const clic = () => {
      if (!l.girando() && l.cara() === "visible") soloChina();
      l.girar();
    };
    let enVuelo = false;
    const clicVolver = () => {
      if (enVuelo || l.girando()) return;
      enVuelo = true;
      borrarEstadoLuna();   // una llegada nueva desde el hero empieza limpia
      boton.disabled = volver.disabled = true;
      // Las chapas y la columna se apagan con los botones: si no, se quedaban
      // flotando mientras la Luna se aleja hacia el icono.
      volverATierra(hero, l, disco, [boton, volver, ...(capa ? [capa] : []), ...(columna ? [columna] : []), ...(sats ? [sats] : []), ...document.querySelectorAll<HTMLElement>(".luna-orbitas")]);
    };
    boton.addEventListener("click", clic);
    volver.addEventListener("click", clicVolver);
    quitaBoton = () => {
      boton.removeEventListener("click", clic);
      volver.removeEventListener("click", clicVolver);
    };
  });

  document.addEventListener("astro:before-swap", () => {
    luna?.desmontar();
    quitaBoton?.();
    luna = null;
    quitaBoton = null;
  });
</script>
