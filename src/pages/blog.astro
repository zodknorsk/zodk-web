---
// /blog: sobre la propia web, qué es y cómo está hecha. Se llega desde la
// tira del blog de la portada. Arriba, en un recuadro, el avatar en pixel art
// y quién escribe; debajo, "Entradas" con cuántas hay y las notas con la
// etiqueta "blog", la más nueva primero.
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { BLOG } from "@consts";
import { porFecha, proyectoDe, primeraFoto } from "@lib/contenido";

const entradas = (await getCollection("notas"))
  .filter((n) => !n.data.draft && proyectoDe(n.data.tags) === "blog")
  .sort(porFecha);

// "27 sept 2026", como en las filas de la portada.
const fechaCorta = (d: Date) =>
  d.toLocaleDateString("es-ES", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).replace(".", "");
const dos = (n: number) => String(n).padStart(2, "0");
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="blog-autor animate">
        <span class="blog-autor-avatar"><img src="/zodk-avatar.gif" alt="" width="192" height="208" /></span>
        <div>
          <h1 class="blog-autor-titulo">Blog</h1>
          <p>
            Soy Hegoi. Desde hace años sigo en directo los grandes sucesos de
            política y actualidad, y aquí los trazo con notas propias desde mi
            bóveda de Obsidian: historia, inteligencia y OSINT. En este blog
            cuento cómo está hecha la web.
          </p>
        </div>
      </div>

      <section class="animate" aria-label="Entradas">
        <h2 class="blog-cab-entradas">Entradas<span>{dos(entradas.length)}</span></h2>
        {entradas.length > 0 ? (
          <ul class="blog-lista">
            {entradas.map((n) => {
              const foto = primeraFoto(n);
              return (
                <li>
                  <a class="blog-entrada" href={`/notas/${n.id}`}>
                    {foto && <span class="blog-foto"><Image src={foto} alt="" width={1200} /></span>}
                    <span class="blog-texto">
                      <span class="fila-fecha">{fechaCorta(n.data.date)}</span>
                      <span class="blog-titulo">{n.data.title}</span>
                      {n.data.description && <span class="blog-entradilla">{n.data.description}</span>}
                      <span class="blog-leer">Leer →</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p>Todavía no hay entradas.</p>
        )}
      </section>
    </div>
  </Container>
</PageLayout>

<script>
  // El avatar se mueve solo (src/scripts/avatar.js); se monta en cada llegada.
  import { montarAvatar } from "../scripts/avatar.js";
  let quita = () => {};
  document.addEventListener("astro:page-load", () => {
    quita();
    const caja = document.querySelector<HTMLElement>(".blog-autor-avatar");
    quita = caja ? montarAvatar(caja) : () => {};
  });
  document.addEventListener("astro:before-swap", () => {
    quita();
    quita = () => {};
  });
</script>
