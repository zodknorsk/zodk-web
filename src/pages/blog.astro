---
// /blog: sobre la propia web, qué es y cómo está hecha. Se llega desde la
// tira del blog de la portada. Arriba, la cabecera de estrellas con el
// "hecho con"; debajo, las notas con la etiqueta "blog", la más nueva primero.
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { BLOG, STACK } from "@consts";
import { porFecha, proyectoDe, primeraFoto } from "@lib/contenido";

const entradas = (await getCollection("notas"))
  .filter((n) => !n.data.draft && proyectoDe(n.data.tags) === "blog")
  .sort(porFecha);

// "27 sept 2026", como en las filas de la portada.
const fechaCorta = (d: Date) =>
  d.toLocaleDateString("es-ES", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).replace(".", "");
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <header class="blog-cab animate">
        <img class="tira-avatar" src="/zodk-avatar.gif" alt="" width="48" height="52" />
        <div class="blog-cab-texto">
          <h1 class="bloque-titulo">Blog</h1>
          <p>{BLOG.DESCRIPTION}</p>
        </div>
        <div class="tira-hecho">
          <span class="tira-hecho-titulo">Hecho con</span>
          {STACK.map((t) => (
            <a class="chip" href={t.HREF} target="_blank" rel="noopener noreferrer" style={`--marca:${t.COLOR}`}>
              <span class="chip-icono" set:html={t.ICONO} />
              {t.NAME}
            </a>
          ))}
        </div>
      </header>

      <p class="animate">
        Entradas sobre cómo está hecha esta web: el planeta en pixel art, los
        astros y el paso de las notas de Obsidian a la web.
      </p>

      {entradas.length > 0 ? (
        <ul class="blog-lista animate">
          {entradas.map((n) => {
            const foto = primeraFoto(n);
            return (
              <li>
                <a class="blog-entrada" href={`/notas/${n.id}`}>
                  {foto && <span class="blog-foto"><Image src={foto} alt="" width={1200} /></span>}
                  <span class="blog-texto">
                    <span class="fila-fecha">{fechaCorta(n.data.date)}</span>
                    <span class="blog-titulo">{n.data.title}</span>
                    {n.data.description && <span class="blog-entradilla">{n.data.description}</span>}
                    <span class="blog-leer">Leer →</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="animate">Todavía no hay entradas.</p>
      )}
    </div>
  </Container>
</PageLayout>
