---
// Página individual de cada nota. El [...slug] genera una ruta por nota:
// /notas/ley-de-nietos, /notas/mi-opinion-sobre-la-53-provincia-espanola, etc.
import { type CollectionEntry, getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import { proyectoDe, porFecha } from "@lib/contenido";

// getStaticPaths le dice a Astro qué páginas generar en el build (sitio estático).
export async function getStaticPaths() {
  const notas = (await getCollection("notas"))
    .filter((nota) => !nota.data.draft)
    .sort(porFecha);
  return notas.map((nota) => ({
    params: { slug: nota.id },
    props: nota,
  }));
}
type Props = CollectionEntry<"notas">;

const nota = Astro.props;
const { Content } = await render(nota);

// Las de Luna y Marte no salen en /notas: "volver" lleva a su astro.
const proyecto = proyectoDe(nota.data.tags);
---

<PageLayout title={nota.data.title} description={nota.data.description ?? ""}>
  <Container>
    <div class="animate">
      {proyecto === "luna"
        ? <BackToPrev href="/luna">Volver a la Luna</BackToPrev>
        : proyecto === "marte"
          ? <BackToPrev href="/marte">Volver a Marte</BackToPrev>
          : <BackToPrev href="/notas">Volver a notas</BackToPrev>}
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5 font-mono">
        <div class="text-sm">
          <FormattedDate date={nota.data.date} />
        </div>
        &bull;
        <div class="text-sm">{readingTime(nota.body ?? "")}</div>
      </div>
      <h1 class="animate text-2xl font-semibold text-black dark:text-white">
        {nota.data.title}
      </h1>
      {
        nota.data.tags.length > 0 && (
          <div class="animate flex flex-wrap gap-1.5 pt-1 text-sm">
            {nota.data.tags.map((tag) => (
              <span class="opacity-75">#{tag}</span>
            ))}
          </div>
        )
      }
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
