---
// Las notas de los proyectos (Luna, Marte y el blog): /notas/<slug>, con su
// «volver» a /luna, /marte o /blog. Las de /notas/<slug> que antes eran
// análisis redirigen a /analisis/<slug>.
import { type CollectionEntry, getCollection } from "astro:content";
import ArticuloPagina from "@components/ArticuloPagina.astro";
import Redireccion from "@components/Redireccion.astro";
import { proyectoDe } from "@lib/contenido";

export async function getStaticPaths() {
  const notas = (await getCollection("notas")).filter((n) => !n.data.draft);
  const analisis = (await getCollection("analisis")).filter((n) => !n.data.draft);
  return [
    ...notas.map((nota) => ({ params: { slug: nota.id }, props: { nota } })),
    ...analisis.map((n) => ({ params: { slug: n.id }, props: { a: `/analisis/${n.id}` } })),
  ];
}
type Props = { nota?: CollectionEntry<"notas">; a?: string };

const { nota, a } = Astro.props;
const VOLVER = {
  luna: { href: "/luna", texto: "Volver a la Luna" },
  marte: { href: "/marte", texto: "Volver a Marte" },
  blog: { href: "/blog", texto: "Volver al blog" },
};
const proyecto = nota ? proyectoDe(nota.data.tags) : null;
---

{nota
  ? <ArticuloPagina entrada={nota} volver={proyecto ? VOLVER[proyecto] : { href: "/", texto: "Volver a la portada" }} />
  : <Redireccion a={a!} />}
