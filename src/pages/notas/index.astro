---
// Listado de todas las notas, agrupadas por año. Ruta resultante: /notas
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import TiraCabecera from "@components/TiraCabecera.astro";
import { NOTAS } from "@consts";
import { esDelBlog, porFecha } from "@lib/contenido";

const data = (await getCollection("notas")).filter(esDelBlog).sort(porFecha);

type Acc = {
  [year: string]: CollectionEntry<"notas">[];
};

const notasPorAno = data.reduce((acc: Acc, nota) => {
  const year = nota.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(nota);
  return acc;
}, {});

const years = Object.keys(notasPorAno).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title={NOTAS.TITLE} description={NOTAS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <TiraCabecera titulo="Notas" desc={NOTAS.DESCRIPTION} pie={`${data.length} nota${data.length === 1 ? "" : "s"} publicada${data.length === 1 ? "" : "s"}`}>
        {/* El número de notas, como un expediente. */}
        <span class="no-numero">N.º<br />{String(data.length).padStart(2, "0")}</span>
      </TiraCabecera>
      <div class="space-y-4">
        {
          years.map((year) => (
            <section class="animate space-y-4">
              <div class="font-semibold text-black dark:text-white">{year}</div>
              <ul class="flex flex-col gap-4">
                {notasPorAno[year].map((nota) => (
                  <li>
                    <ArrowCard entry={nota} tituloAzul />
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </Container>
</PageLayout>

<style>
  .no-numero { font-size: 1.1rem; line-height: 1.15; text-align: center; letter-spacing: 0.04em; }
</style>

