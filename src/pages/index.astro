          {
            STACK.map((tech) => (
              <li>
                <a
                  href={tech.HREF}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={tech.NAME}
                  class="flex items-center gap-1.5 rounded-lg border border-black/15 dark:border-white/20 px-2.5 py-1.5 font-bold text-black/70 dark:text-white/75 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
                >
                  <span class="flex items-center justify-center shrink-0" set:html={tech.ICONO} />
