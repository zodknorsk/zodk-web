// En la portada solo se ve la hélice, bajo la esquina de abajo a la
// izquierda del visor (la coordenada va a la derecha): el mismo
// dibujo con el viewBox recortado a ella; el cuadrado y la flecha se ocultan
// en CSS (.btn-caja, .btn-flecha). Decisión del usuario: "sin recuadro".
const heliceSvg = botonSvg.replace(
  `viewBox="0 0 203.62 179.21" width="407.25" height="358.43"`,
  `viewBox="13.4 94.7 62 62"`,
);

// Las notas del Proyecto Luna (etiqueta "luna") y del Proyecto Marte ("marte")
// no salen aquí: se quedan en /luna y /marte, y solo se llega a ellas desde
// allí o desde "moon-project" / "mars-project".
const notas = (await getCollection("notas"))
  .filter((nota) => !nota.data.draft && !nota.data.tags.some((t) => ["luna", "marte"].includes(t.toLowerCase())))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_NOTAS_ON_HOMEPAGE);

const todosEventos = await getCollection("eventos");

// Chapas de bandera del planeta: un país sale si algún artículo lleva una de
// sus etiquetas (src/data/paises.ts). Al pasar el ratón por la chapa se
// despliega una ficha, como la de las naves, con esos artículos. Las notas
// cuentan una a una; los eventos, por su página índice. Lo de los proyectos
// Luna y Marte (etiquetas "luna" y "marte") queda fuera: esas misiones llevan
// también etiqueta de país (eeuu, china...), pero tienen su propia página y no
// deben salir en las banderas de la Tierra.
const articulos = [
  ...(await getCollection("notas"))
    .filter((n) => !n.data.draft && !n.data.tags.some((t) => ["luna", "marte"].includes(t.toLowerCase())))
    .map((n) => ({ titulo: n.data.title, url: `/notas/${n.id}`, tipo: "Nota", fecha: n.data.date, tags: n.data.tags })),
  ...todosEventos
    .filter((e) => e.data.kind === "index" && !e.data.draft && !e.data.tags.some((t) => ["luna", "marte"].includes(t.toLowerCase())))
    .map((e) => ({ titulo: e.data.title, url: `/eventos/${e.data.evento}`, tipo: "Evento", fecha: e.data.date, tags: e.data.tags })),
];
const banderasBlog = PAISES.map((p) => ({
  ...p,
  articulos: articulos
    .filter((a) => a.tags.some((t) => p.etiquetas.includes(t.toLowerCase())))
    .sort((a, b) => b.fecha.valueOf() - a.fecha.valueOf()),
})).filter((p) => p.articulos.length > 0);
const eventos = todosEventos
  .filter((e) => e.data.kind === "index" && !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((ev) => ({
    ev,
    semanas: todosEventos.filter(
      (x) =>
        x.data.evento === ev.data.evento &&
        x.data.kind === "semana" &&
        !x.data.draft,
    ).length,
  }));
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} hero>
  <section slot="hero" class="hero" aria-label="Portada">
    <div class="hero-stars" aria-hidden="true"></div>
    <span class="hero-sparkle" aria-hidden="true"></span>
    <!-- Sol (día) y luna (noche) en el mismo sitio; el planeta pasa por delante.
         La luna lleva la fase del día (faseLuna() más abajo). -->
    <div class="hero-astro" aria-hidden="true">
      <span class="astro-sol"></span>
      <span class="astro-luna"></span>
    </div>
    <!-- Proyecto Luna: la luna (solo de noche) lleva a /luna con un vuelo
         (montarViaje() más abajo). -->
    <a class="hero-luna-enlace" href="/luna" aria-label="Viajar a la Luna" title="Viajar a la Luna"></a>
    <!-- Proyecto Marte: Marte, arriba a la derecha (de día y de noche), lleva
         a /marte con el mismo vuelo. -->
    <div class="hero-marte" aria-hidden="true"></div>
    <a class="hero-marte-enlace" href="/marte" aria-label="Viajar a Marte" title="Viajar a Marte"></a>
    <!-- La Tierra entera (Proyecto Tierra, logo-files/TIERRA-WIP.md): el lienzo
         WebGL (tierra-gl.js) ocupa todo el hero, porque con zoom el disco lo
         llena. .hero-planet es la Tierra quieta (tierra-quieto.png): se ve
         mientras carga y sin WebGL2, y es la caja del disco que miden los
         vuelos. -->
    <div class="hero-planet" role="img" aria-label="La Tierra en pixel art, girando"></div>
    <div class="hero-tierra" aria-hidden="true">
      <canvas class="hero-tierra-canvas"></canvas>
      <div class="hero-tierra-sonda"></div>
    </div>
    <!-- Nombres de continentes y países, que salen al acercarse (la capa de
         Marte y la Luna, marte-nombres.js; public/planeta/tierra-nombres.json). -->
    <div class="marte-nombres tierra-nombres" aria-hidden="true"></div>
    <div class="hero-banderas">
      {banderasBlog.map((p) => (
        <div class="hero-bandera" data-iso={p.iso} tabindex="0" hidden aria-label={`${p.nombre}: artículos relacionados`}>
          <div class="craft-dossier">
