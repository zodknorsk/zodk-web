      <h1>el blog de <span>hegoi márquez</span></h1>
      <p>
        <span>Historia</span> · <span>Inteligencia</span> · <span>OSINT</span>
      </p>
      <div class="hero-marco">
        <div class="hero-lectura">
          <button class="hero-giro" type="button" aria-label="Parar el giro del planeta" aria-pressed="false">
            <svg class="icono-pausa" viewBox="0 0 7 9" aria-hidden="true"><rect x="1" y="1" width="2" height="7" /><rect x="4" y="1" width="2" height="7" /></svg>
            <svg class="icono-play" viewBox="0 0 6 9" aria-hidden="true"><rect x="1" y="1" width="1" height="7" /><rect x="2" y="2" width="1" height="5" /><rect x="3" y="3" width="1" height="3" /><rect x="4" y="4" width="1" height="1" /></svg>
          </button>
