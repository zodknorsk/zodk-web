---
// Portada del sitio (ruta "/"). Sencilla: saludo, presentación breve, últimas
// notas, últimos eventos y contacto. Para ampliarla, añade <section> nuevas
// dentro del <div class="space-y-16">.
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, STACK, CONTACTO } from "@consts";
import { AERONAVES } from "@data/aeronaves";
import { PAISES } from "@data/paises";

// El hero muestra UN objeto de AERONAVES a la vez (dron, avión o satélite),
// elegido al azar en el navegador con "bolsa barajada" (se recorren todos antes
// de repetir). Cada objeto hace su propia trayectoria (sweep / orbita / fijo).
// No hay relevo automático: solo cambia al pulsar el botón .hero-cambio, que
// desvanece el actual y trae otro con un fundido. Lo lleva initObjeto() en
// Head.astro; sin JS se ve el primero de la lista, quieto. Ver
// src/data/aeronaves.ts.
const objetoInicial = AERONAVES[0];

// SVG del botón "otro objeto", PLACEHOLDER montado con dos exports de Excalidraw
// del usuario: el cuadrado + la flecha discontinuos, y su hélice del E-2 dentro
// (la "diana de click"). Limpieza aplicada a ambos: fuera el <rect> de fondo del
// lienzo, fuera los trazos de relleno invisibles (stroke #ededed00, ~24 KB) y
// decimales recortados a 2. Clases para animar desde global.css / Head.astro:
// .btn-caja (los 4 lados), .btn-flecha (estática), .btn-helice > .btn-helice-giro
// (gira con initHelice()). Se cambia aquí sin tocar el JS mientras el <button>
// mantenga la clase .hero-cambio.
const botonSvg = `<svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 203.62 179.21" width="407.25" height="358.43" aria-hidden="true" focusable="false"><!-- svg-source:excalidraw --><metadata></metadata><defs><style class="style-fonts">
