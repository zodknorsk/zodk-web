const notas = (await getCollection("notas"))
  .filter((nota) => !nota.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_NOTAS_ON_HOMEPAGE);

const todosEventos = await getCollection("eventos");
const eventos = todosEventos
  .filter((e) => e.data.kind === "index" && !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((ev) => ({
    ev,
    semanas: todosEventos.filter(
      (x) =>
        x.data.evento === ev.data.evento &&
        x.data.kind === "semana" &&
        !x.data.draft,
    ).length,
  }));
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} hero>
  <section slot="hero" class="hero" aria-label="Portada">
    <div class="hero-stars" aria-hidden="true"></div>
    <span class="hero-sparkle" aria-hidden="true"></span>
    <div
      class="hero-planet"
      role="img"
      aria-label="La Tierra en pixel art, hemisferio norte, girando"
    >
    </div>
    <div class="hero-titulo">
      <h1>el blog de <span>hegoi márquez</span></h1>
      <p>
        <span>Historia</span> · <span>Inteligencia</span> · <span>OSINT</span>
      </p>
    </div>
    <div
      class:list={[
        "hero-craft",
        `hero-craft--${objetoInicial.vuelo}`,
        objetoInicial.sprite.endsWith(".svg") && "hero-craft--pixelado",
      ]}
      data-craft={objetoInicial.id}
      data-slot="0"
      aria-hidden="true"
      style={`aspect-ratio:${objetoInicial.ratio};--sprite:url(${objetoInicial.sprite});--sprite-noche:url(${objetoInicial.spriteNoche});--escala:${objetoInicial.escala ?? 1}`}
    >
      <div class="craft-dossier">
        <span class="craft-linea" />
        <div class="craft-specs">
          <div class="craft-specs-titulo">{objetoInicial.nombre}</div>
          <div class="craft-clase">{objetoInicial.clase}</div>
          <dl>
            {objetoInicial.specs.map(([k, v]) => (
              <Fragment>
                <dt>{k}</dt>
                <dd>
                  {v}
                  {k === "Origen" && objetoInicial.bandera && (
                    <span class="craft-flag">{objetoInicial.bandera}</span>
                  )}
                </dd>
              </Fragment>
            ))}
          </dl>
        </div>
      </div>
    </div>
    {AERONAVES.length > 1 && (
      <>
        <button
          class="hero-cambio"
          type="button"
          aria-label="Mostrar otro objeto"
          title="Otro objeto"
          hidden
          set:html={botonSvg}
        />
        <script
          type="application/json"
          id="aeronaves-data"
          set:html={JSON.stringify(AERONAVES)}
        />
      </>
    )}
    <span class="hero-scroll" aria-hidden="true"></span>
  </section>

  <!-- Marca el límite hero/contenido: la cabecera con logo no aparece hasta
       que este punto llega arriba del todo (ver initHeader en Head.astro). -->
  <div id="hero-sentinel" aria-hidden="true"></div>

  <Container>
    <h2 class="animate font-semibold text-black dark:text-white">
      Hola <span class="text-xl">👋</span>
    </h2>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            Esto es <strong>zodk.eu</strong>, mi blog personal. Aquí publico
            notas y análisis propios sobre actualidad, historia y OSINT
            (inteligencia de fuentes abiertas), escritos a partir de mi archivo
            de trabajo.
          </p>
          <p class="animate">
            El blog está en una fase muy temprana. El contenido se irá ampliando
            poco a poco. Puedes ver todo lo publicado en
            <Link href="/notas">notas</Link> y <Link href="/eventos">eventos</Link>.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Últimas notas</h5>
          <Link href="/notas">Ver todas</Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            notas.map((nota) => (
              <li>
                <ArrowCard entry={nota} />
              </li>
            ))
          }
        </ul>
      </section>

      {
        eventos.length > 0 && (
          <section class="animate space-y-6">
            <div class="flex flex-wrap gap-y-2 items-center justify-between">
              <h5 class="font-semibold text-black dark:text-white">
                Últimos eventos
              </h5>
              <Link href="/eventos">Ver todos</Link>
            </div>
            <ul class="flex flex-col gap-4">
              {eventos.map(({ ev, semanas }) => (
                <li>
                  <a
                    href={`/eventos/${ev.data.evento}`}
                    class="relative group flex flex-nowrap py-3 px-4 pr-10 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
                  >
                    <div class="flex flex-col flex-1 truncate">
                      <div class="font-semibold">{ev.data.title}</div>
                      <div class="text-sm">
                        Desde <FormattedDate date={ev.data.date} /> ·{" "}
                        {semanas} semana{semanas === 1 ? "" : "s"}
                      </div>
                    </div>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out" />
                      <polyline points="12 5 19 12 12 19" class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">Hecha con</h5>
        <ul class="flex flex-wrap gap-3">
          {
            STACK.map((tech) => (
              <li class="flex items-center gap-2 rounded-lg border border-black/15 dark:border-white/20 px-3 py-2">
                <span
                  class="flex items-center justify-center size-6 shrink-0 rounded text-[10px] font-bold text-white"
                  style={`background:${tech.COLOR}`}
                >
                  {tech.MARCA}
                </span>
                {tech.NAME}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">Contacto</h5>
        <article>
          <p>Si quieres escribirme, aquí me tienes:</p>
        </article>
      </section>
    </div>
  </Container>

  <!-- Barra de redes a sangre (ancho completo, fuera del Container): X,
       correo e Instagram. Vive fuera de <Container> a propósito -- es hija
       directa de <main>, que no tiene max-width, así que ocupa todo el ancho
       sin trucos de vw/márgenes negativos. El margin-bottom negativo
       cancela el pb-32 de <main> para que quede pegada al footer. -->
  <section class="social-bar animate" aria-label="Redes sociales">
    <ul>
      {
        CONTACTO.map((c) => (
          <li>
            <a href={c.HREF} target={c.EXTERNO ? "_blank" : undefined} rel={c.EXTERNO ? "noopener noreferrer" : undefined} aria-label={c.LABEL}>
              <span class="social-icon" set:html={c.ICONO} />
              <span>{c.TEXTO}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</PageLayout>

<style>
  .social-bar {
    width: 100%;
    margin-bottom: -8rem; /* cancela el pb-32 (8rem) de <main> */
    padding: 2.5rem 1.25rem;
    background: linear-gradient(135deg, #05060a 0%, #101a30 55%, #05060a 100%);
  }
  .social-bar ul {
    max-width: 56rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.1rem 0;
  }
  .social-bar li { display: flex; align-items: center; }
  .social-bar li:not(:last-child)::after {
    content: "";
    width: 1px;
    height: 1.6rem;
    background: rgba(255, 255, 255, 0.15);
    margin: 0 clamp(1rem, 4vw, 2.5rem);
  }
  .social-bar a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #f3efe6;
    font-family: "IBM Plex Serif", ui-serif, Georgia, serif;
    font-weight: 600;
    font-size: clamp(0.82rem, 2vw, 1rem);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .social-bar a:hover { color: #e6c078; }
  /* :global() -- el SVG se inyecta con set:html (ver consts.ts) y por tanto
     no lleva el atributo de scope de Astro; sin :global() esta regla no lo
     alcanzaría. El tamaño real ya va en el propio SVG; esto es red de
     seguridad + flex-shrink. */
  .social-bar :global(svg) { width: 1.15rem; height: 1.15rem; flex-shrink: 0; }
  @media (max-width: 640px) {
    .social-bar ul { flex-direction: column; gap: 1.1rem; }
    .social-bar li:not(:last-child)::after { display: none; }
  }
</style>
